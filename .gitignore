# =====================================================================
# SignalGenerator — Git Ignore Configuration
# =====================================================================

# 1. Environment variables, API keys, EIP-712 private keys & webhooks
.env
.env.*
.env.local
!.env.example
*.pem
*.key
*secret*
credentials.json

# 2. Local SQLite databases, WAL/SHM journals & runtime state
data/*.db
data/*.db-wal
data/*.db-shm
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# 3. Runtime logs & temporary diagnostics
logs/
*.log
tmp/
temp/
scratch/
*.tmp
*.bak
*.orig

# 4. Python bytecode, caches & test/coverage artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.pytest-*/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
dist/
build/
*.egg-info/

# 5. Virtual environments
.venv/
venv/
env/
ENV/

# 6. IDE, Editor & OS metadata
.vscode/
.idea/
.cursor/
.claude/
*.swp
*.swo
.DS_Store
Thumbs.db
Desktop.ini
node_modules/
