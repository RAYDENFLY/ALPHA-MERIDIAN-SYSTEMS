# =====================================================================
# SignalGenerator — Environment Configuration Template (.env.example)
# =====================================================================

# 1. Operational Mode
# Default: RESEARCH (safe read-only). Explicit override: PAPER (simulated forward testing)
SCANNER_MODE=PAPER

# 2. Discord Webhook Monitoring (Paper Trading & Execution Lifecycle)
DISCORD_WEBHOOK_URL=

# 2b. Universal AsterDEX Perpetual Price Alerts Discord Notifications (Optional)
# Webhook URL for real-time AsterDEX perpetual price alerts crossing notifications
# Leave empty to keep Discord notifications disabled while in-dashboard alerts remain active.
# Placeholder example (replace with your private channel webhook):
# DISCORD_PRICE_ALERT_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN
DISCORD_PRICE_ALERT_WEBHOOK_URL=

# 3. Aster DEX Credentials & Authenticated Endpoints
# Mode PAPER: TIDAK memerlukan kredensial apapun. Seluruh market data publik.
# Aster DEX Futures API V3 (Pro API) berbasis Web3 API-Wallet (EIP-712 Signing).
# Mainnet Profile (Chain ID 1666):
ASTER_USER_ADDRESS=
ASTER_SIGNER_ADDRESS=
ASTER_SIGNER_PRIVATE_KEY=
# Testnet Profile (Chain ID 714 - Strictly Isolated):
# ASTER_TESTNET_USER_ADDRESS=
# ASTER_TESTNET_SIGNER_ADDRESS=
# ASTER_TESTNET_SIGNER_PRIVATE_KEY=
# ASTER_CHAIN_ID=1666

# 4. Paper Execution Simulation Parameters
PAPER_SLIPPAGE_RATE=0.0005

# 5. Local Server Binding & Mutating Endpoint Protection
PORT=8000
HOST=127.0.0.1
SCANNER_API_TOKEN=

# 6. Optional AI Qualitative Enrichment (Default: Disabled)
QWEN_ANALYSIS_ENABLED=false
QWEN_AI_MODE=NO_AI
QWEN_API_URL=
QWEN_API_TOKEN=
