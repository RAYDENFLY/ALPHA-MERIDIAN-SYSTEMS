<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SignalGenerator.Desktop.ViewModels"
             xmlns:models="using:SignalGenerator.Desktop.Models"
             mc:Ignorable="d" d:DesignWidth="1400" d:DesignHeight="850"
             x:Class="SignalGenerator.Desktop.Views.MultiMarketOrderBookView"
             x:DataType="vm:MultiMarketOrderBookViewModel"
             Background="#000000">

    <Grid RowDefinitions="Auto,*">

        <!-- Top Control & Status Strip -->
        <Border Grid.Row="0" Background="#0A0D10" BorderBrush="#242A34" BorderThickness="0,0,0,1" Padding="12,8">
            <Grid ColumnDefinitions="Auto,*,Auto">
                
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="■ MULTI-MARKET ORDER BOOK" FontSize="12" FontWeight="Bold" Foreground="#FF9D00" FontFamily="Consolas, monospace" VerticalAlignment="Center" />
                    <Border Background="#161B22" BorderBrush="#242A34" BorderThickness="1" Padding="6,2">
                        <TextBlock Text="8 CONCURRENT CHANNELS (4×2 GRID)" FontSize="9" FontWeight="Bold" Foreground="#8B949E" FontFamily="Consolas, monospace" />
                    </Border>
                    <Border Background="#12161C" BorderBrush="#00E676" BorderThickness="1" Padding="6,2">
                        <TextBlock Text="{Binding GlobalFeedStatus}" FontSize="9" FontWeight="Bold" Foreground="#00E676" FontFamily="Consolas, monospace" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="LAST SYNC:" FontSize="10" Foreground="#8B949E" FontFamily="Consolas, monospace" />
                        <TextBlock Text="{Binding LastGlobalSyncText}" FontSize="10" FontWeight="Bold" Foreground="#F0F4F8" FontFamily="Consolas, monospace" />
                    </StackPanel>
                    <Button Command="{Binding RefreshAllTilesCommand}" Classes="terminal-btn" Padding="8,4">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="↻" FontSize="11" Foreground="#FF9D00" FontWeight="Bold" />
                            <TextBlock Text="SYNC ALL FEEDS" FontSize="10" Foreground="#F0F4F8" FontWeight="Bold" />
                        </StackPanel>
                    </Button>
                </StackPanel>

            </Grid>
        </Border>

        <!-- Main 4×2 Grid of 8 Market Tiles -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding MarketTiles}" Margin="6">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4" Rows="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:MarketBookTileModel">
                        <Border Background="#0A0D10" BorderBrush="#242A34" BorderThickness="1" Margin="4" Padding="8">
                            <Grid RowDefinitions="Auto,Auto,*,Auto">
                                
                                <!-- Tile Header: Symbol, Type, Last Price, Status -->
                                <Border Grid.Row="0" BorderBrush="#242A34" BorderThickness="0,0,0,1" Padding="0,0,0,6" Margin="0,0,0,6">
                                    <Grid ColumnDefinitions="*,Auto,Auto">
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
                                            <TextBlock Text="{Binding Symbol}" FontSize="12" FontWeight="Bold" Foreground="#FF9D00" FontFamily="Consolas, monospace" VerticalAlignment="Center" />
                                            <Border Background="#161B22" BorderBrush="#242A34" BorderThickness="1" Padding="4,1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding MarketType}" FontSize="8" FontWeight="Bold" Foreground="#8B949E" FontFamily="Consolas, monospace" />
                                            </Border>
                                        </StackPanel>

                                        <TextBlock Grid.Column="1" Text="{Binding LastPriceFormatted}" FontSize="11" FontWeight="Bold" 
                                                   Foreground="#00E676" FontFamily="Consolas, monospace" VerticalAlignment="Center" Margin="0,0,8,0" />

                                        <Border Grid.Column="2" Background="#12161C" BorderBrush="{Binding StatusBadgeColor}" BorderThickness="1" Padding="4,1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ConnectionState}" FontSize="8" FontWeight="Bold" Foreground="{Binding StatusBadgeColor}" FontFamily="Consolas, monospace" />
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Tile Sub-Header: Bid, Ask, Spread & Wall Metrics -->
                                <Border Grid.Row="1" Background="#06080A" BorderBrush="#1C2128" BorderThickness="1" Padding="6,4" Margin="0,0,0,6">
                                    <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,*">
                                        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="4">
                                            <TextBlock Text="BID:" FontSize="9" Foreground="#8B949E" FontFamily="Consolas, monospace" />
                                            <TextBlock Text="{Binding BestBidFormatted}" FontSize="9" FontWeight="Bold" Foreground="#00E676" FontFamily="Consolas, monospace" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                            <TextBlock Text="ASK:" FontSize="9" Foreground="#8B949E" FontFamily="Consolas, monospace" />
                                            <TextBlock Text="{Binding BestAskFormatted}" FontSize="9" FontWeight="Bold" Foreground="#FF5252" FontFamily="Consolas, monospace" />
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Spacing="4" Margin="0,2,0,0">
                                            <TextBlock Text="SPREAD:" FontSize="9" Foreground="#8B949E" FontFamily="Consolas, monospace" />
                                            <TextBlock Text="{Binding SpreadFormatted}" FontSize="9" Foreground="#FF9D00" FontFamily="Consolas, monospace" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="4" Margin="0,2,0,0">
                                            <TextBlock Text="WALL:" FontSize="9" Foreground="#8B949E" FontFamily="Consolas, monospace" />
                                            <TextBlock Text="{Binding MajorBidWallFormatted}" FontSize="9" Foreground="#C9D1D9" FontFamily="Consolas, monospace" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Compact Order Book Ladder: Asks on top, Mid in center, Bids below -->
                                <Grid Grid.Row="2" RowDefinitions="*,Auto,*" Margin="0,0,0,6">
                                    
                                    <!-- Asks (Red) -->
                                    <ItemsControl Grid.Row="0" ItemsSource="{Binding Asks}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:OrderBookLevelItem">
                                                <Grid ColumnDefinitions="*,*,*" Margin="0,1">
                                                    <TextBlock Grid.Column="0" Text="{Binding PriceFormatted}" FontSize="10" Foreground="#FF5252" FontFamily="Consolas, monospace" />
                                                    <TextBlock Grid.Column="1" Text="{Binding SizeFormatted}" FontSize="10" Foreground="#C9D1D9" HorizontalAlignment="Right" FontFamily="Consolas, monospace" />
                                                    <TextBlock Grid.Column="2" Text="{Binding CumulativeFormatted}" FontSize="9" Foreground="#8B949E" HorizontalAlignment="Right" FontFamily="Consolas, monospace" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Mid-Price Divider -->
                                    <Border Grid.Row="1" Background="#161B22" BorderBrush="#242A34" BorderThickness="0,1,0,1" Padding="4,2" Margin="0,2">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Text="MID SPREAD" FontSize="8" Foreground="#8B949E" FontFamily="Consolas, monospace" />
                                            <TextBlock Grid.Column="1" Text="{Binding LastPriceFormatted}" FontSize="10" FontWeight="Bold" Foreground="#FF9D00" FontFamily="Consolas, monospace" />
                                        </Grid>
                                    </Border>

                                    <!-- Bids (Green) -->
                                    <ItemsControl Grid.Row="2" ItemsSource="{Binding Bids}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:OrderBookLevelItem">
                                                <Grid ColumnDefinitions="*,*,*" Margin="0,1">
                                                    <TextBlock Grid.Column="0" Text="{Binding PriceFormatted}" FontSize="10" Foreground="#00E676" FontFamily="Consolas, monospace" />
                                                    <TextBlock Grid.Column="1" Text="{Binding SizeFormatted}" FontSize="10" Foreground="#C9D1D9" HorizontalAlignment="Right" FontFamily="Consolas, monospace" />
                                                    <TextBlock Grid.Column="2" Text="{Binding CumulativeFormatted}" FontSize="9" Foreground="#8B949E" HorizontalAlignment="Right" FontFamily="Consolas, monospace" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                </Grid>

                                <!-- Tile Footer: Trade Button + Timestamp -->
                                <Border Grid.Row="3" BorderBrush="#1C2128" BorderThickness="0,1,0,0" Padding="0,4,0,0">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="{Binding LastUpdatedText}" FontSize="8" Foreground="#8B949E" FontFamily="Consolas, monospace" VerticalAlignment="Center" />
                                        <Button Grid.Column="1" 
                                                Command="{Binding $parent[UserControl].((vm:MultiMarketOrderBookViewModel)DataContext).OpenInTradingWorkstationCommand}"
                                                CommandParameter="{Binding Symbol}"
                                                Background="#161B22" BorderBrush="#FF9D00" BorderThickness="1" CornerRadius="0" Padding="6,2">
                                            <TextBlock Text="TRADE PAIR →" FontSize="9" FontWeight="Bold" Foreground="#FF9D00" FontFamily="Consolas, monospace" />
                                        </Button>
                                    </Grid>
                                </Border>

                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

    </Grid>
</UserControl>
