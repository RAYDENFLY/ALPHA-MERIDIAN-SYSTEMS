<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SignalGenerator.Desktop.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1150" d:DesignHeight="750"
             x:Class="SignalGenerator.Desktop.Views.LiquidityIntelView"
             x:DataType="vm:LiquidityIntelViewModel"
             Background="#000000">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="10" Margin="14">
            
            <!-- Header Banner -->
            <Border Background="#0E1217" BorderBrush="#242A34" BorderThickness="1" Padding="12,8">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="■ LIQUIDITY INTELLIGENCE // L2 BOOK DEPTH &amp; WHALE WALLS" 
                                   FontSize="12" 
                                   FontWeight="Bold" 
                                   FontFamily="Consolas, monospace" 
                                   Foreground="#FF9D00" />
                        <TextBlock Text="Cross-book order flow depth, protecting bid/ask walls, and institutional whale cluster detection" 
                                   FontSize="10" 
                                   FontFamily="Consolas, monospace" 
                                   Foreground="#8B949E" 
                                   Margin="0,2,0,0" />
                    </StackPanel>

                    <Button Grid.Column="1" 
                            Command="{Binding RefreshIntelCommand}" 
                            Classes="terminal-btn"
                            Padding="10,4"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="↻" FontSize="11" Foreground="#FF9D00" FontWeight="Bold" />
                            <TextBlock Text="SYNC DEPTH" FontSize="10" Foreground="#F0F4F8" FontWeight="Bold" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Major Defense Walls (2-Column Grid) -->
            <Grid ColumnDefinitions="*,*" Margin="0,2,0,0">
                
                <!-- Bid Wall (Support Shield) -->
                <Border Grid.Column="0" Margin="0,0,5,0" Background="#0A0D10" BorderBrush="#242A34" BorderThickness="1" Padding="12">
                    <StackPanel Spacing="8">
                        <Border BorderBrush="#242A34" BorderThickness="0,0,0,1" Padding="0,0,0,4">
                            <TextBlock Text="■ MAJOR BID WALL // DEMAND CLUSTER (SUPPORT)" FontSize="11" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#00E676" />
                        </Border>
                        
                        <TextBlock Text="{Binding BidWallLevel}" FontSize="18" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#00E676" />
                        <TextBlock Text="Active demand cluster identified across Aster DEX Level-2 orderbook. Serves as Anchor 3 protective shield for LONG invalidation." 
                                   FontSize="10" FontFamily="Consolas, monospace" Foreground="#8B949E" TextWrapping="Wrap" />

                        <Border Background="#0E1217" BorderBrush="#1C212A" BorderThickness="1" Padding="8,4">
                            <Grid ColumnDefinitions="*,*">
                                <TextBlock Grid.Column="0" Text="WALL FILTER: [0.40%, 1.60%]" FontSize="9" FontFamily="Consolas, monospace" Foreground="#FF9D00" />
                                <TextBlock Grid.Column="1" Text="STATUS: VERIFIED" FontSize="9" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#00E676" HorizontalAlignment="Right" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Ask Wall (Resistance Shield) -->
                <Border Grid.Column="1" Margin="5,0,0,0" Background="#0A0D10" BorderBrush="#242A34" BorderThickness="1" Padding="12">
                    <StackPanel Spacing="8">
                        <Border BorderBrush="#242A34" BorderThickness="0,0,0,1" Padding="0,0,0,4">
                            <TextBlock Text="■ MAJOR ASK WALL // SUPPLY OVERHANG (RESISTANCE)" FontSize="11" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#FF5252" />
                        </Border>

                        <TextBlock Text="{Binding AskWallLevel}" FontSize="18" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#FF5252" />
                        <TextBlock Text="Active supply ceiling identified across Aster DEX Level-2 orderbook. Serves as Anchor 3 protective shield for SHORT invalidation." 
                                   FontSize="10" FontFamily="Consolas, monospace" Foreground="#8B949E" TextWrapping="Wrap" />

                        <Border Background="#0E1217" BorderBrush="#1C212A" BorderThickness="1" Padding="8,4">
                            <Grid ColumnDefinitions="*,*">
                                <TextBlock Grid.Column="0" Text="WALL FILTER: [0.40%, 1.60%]" FontSize="9" FontFamily="Consolas, monospace" Foreground="#FF9D00" />
                                <TextBlock Grid.Column="1" Text="STATUS: VERIFIED" FontSize="9" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#00E676" HorizontalAlignment="Right" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

            </Grid>

            <!-- Whale Order Flow & Institutional Accumulation Stream -->
            <Border Background="#0A0D10" BorderBrush="#242A34" BorderThickness="1" Padding="12">
                <StackPanel Spacing="8">
                    <Border BorderBrush="#242A34" BorderThickness="0,0,0,1" Padding="0,0,0,4">
                        <TextBlock Text="■ INSTITUTIONAL WHALE ACTIVITY &amp; ACCUMULATION FLOW" FontSize="11" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#FF9D00" />
                    </Border>

                    <Border Background="#0E1217" BorderBrush="#1C212A" BorderThickness="1" Padding="10,8">
                        <TextBlock Text="{Binding WhaleEventSummary}" FontSize="12" FontFamily="Consolas, monospace" Foreground="#448AFF" TextWrapping="Wrap" />
                    </Border>

                    <Grid ColumnDefinitions="*,*">
                        <TextBlock Grid.Column="0" Text="SOURCE: Aster DEX L2 Feed &amp; Binance Reference Aggregator" FontSize="9" FontFamily="Consolas, monospace" Foreground="#545D68" />
                        <TextBlock Grid.Column="1" Text="INVARIANT: READ-ONLY INTELLIGENCE" FontSize="9" FontFamily="Consolas, monospace" Foreground="#00E676" HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
