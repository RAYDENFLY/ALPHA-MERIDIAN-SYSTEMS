<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SignalGenerator.Desktop.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
             x:Class="SignalGenerator.Desktop.Views.LiquidityIntelView"
             x:DataType="vm:LiquidityIntelViewModel">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16" Margin="24">
            
            <TextBlock Text="Liquidity Intelligence &amp; Orderbook Depth" 
                       FontSize="22" 
                       FontWeight="Bold" 
                       Foreground="#F0F6FC" />
            <TextBlock Text="Level-2 cross-book aggregation, whale wall clusters, and spoofing detection" 
                       FontSize="13" 
                       Foreground="#8B949E" 
                       Margin="0,0,0,8" />

            <Grid ColumnDefinitions="*,*" Margin="0,8,0,0">
                <!-- Bid Wall Card -->
                <Border Grid.Column="0" Margin="0,0,8,0" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="8">
                        <TextBlock Text="MAJOR BID WALL (SUPPORT)" FontSize="11" FontWeight="Bold" Foreground="#3FB950" />
                        <TextBlock Text="{Binding BidWallLevel}" FontSize="18" FontWeight="Bold" Foreground="#F0F6FC" />
                        <TextBlock Text="Active demand cluster identified across AsterDEX L2 book" FontSize="11" Foreground="#8B949E" />
                    </StackPanel>
                </Border>

                <!-- Ask Wall Card -->
                <Border Grid.Column="1" Margin="8,0,0,0" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="8">
                        <TextBlock Text="MAJOR ASK WALL (RESISTANCE)" FontSize="11" FontWeight="Bold" Foreground="#F85149" />
                        <TextBlock Text="{Binding AskWallLevel}" FontSize="18" FontWeight="Bold" Foreground="#F0F6FC" />
                        <TextBlock Text="Supply threshold protecting structural sweep invalidation" FontSize="11" Foreground="#8B949E" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock Text="WHALE ACTIVITY &amp; ACCUMULATION FLOW" FontSize="11" FontWeight="Bold" Foreground="#8B949E" />
                    <TextBlock Text="{Binding WhaleEventSummary}" FontSize="13" FontFamily="Consolas, monospace" Foreground="#58A6FF" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
