<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SignalGenerator.Desktop.ViewModels"
             xmlns:models="using:SignalGenerator.Desktop.Models"
             xmlns:controls="using:SignalGenerator.Desktop.Controls"
             xmlns:views="using:SignalGenerator.Desktop.Views"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="1100"
             x:Class="SignalGenerator.Desktop.Views.LiquidityIntelView"
             x:DataType="vm:LiquidityIntelViewModel"
             Background="#000000">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="10" Margin="14">
            
            <!-- Header Banner -->
            <Border Background="#0E1217" BorderBrush="#242A34" BorderThickness="1" Padding="12,8">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="■ LIQUIDITY &amp; ORDER FLOW WORKSTATION" 
                                       FontSize="12" 
                                       FontWeight="Bold" 
                                       FontFamily="Consolas, monospace" 
                                       Foreground="#FF9D00" />
                            <Border Background="#1C2128" BorderBrush="#242A34" BorderThickness="1" Padding="6,1" CornerRadius="2">
                                <TextBlock Text="{Binding Status}" FontSize="9" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="{Binding StatusColor}" />
                            </Border>
                            <TextBlock Text="{Binding FeedProvenance}" FontSize="9" FontFamily="Consolas, monospace" Foreground="#8B949E" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="Professional TradingView-style interactive chart, multi-period EMAs, synchronized Stochastic 5,3,3, and cumulative market depth" 
                                   FontSize="10" 
                                   FontFamily="Consolas, monospace" 
                                   Foreground="#8B949E" 
                                   Margin="0,2,0,0" />
                    </StackPanel>

                    <!-- Symbol & Timeframe Selectors -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="PAIR:" FontSize="10" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#8B949E" VerticalAlignment="Center" />
                        <ComboBox ItemsSource="{Binding AvailableSymbols}" 
                                  SelectedItem="{Binding Symbol}" 
                                  FontSize="10" 
                                  FontFamily="Consolas, monospace"
                                  Background="#161B22"
                                  Foreground="#FF9D00"
                                  BorderBrush="#242A34"
                                  Width="110" />

                        <TextBlock Text="TF:" FontSize="10" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#8B949E" VerticalAlignment="Center" Margin="6,0,0,0" />
                        <ComboBox ItemsSource="{Binding AvailableTimeframes}" 
                                  SelectedItem="{Binding Timeframe}" 
                                  FontSize="10" 
                                  FontFamily="Consolas, monospace"
                                  Background="#161B22"
                                  Foreground="#00E676"
                                  BorderBrush="#242A34"
                                  Width="70" />

                        <Button Command="{Binding RefreshIntelCommand}" 
                                Classes="terminal-btn"
                                Padding="10,4">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="↻" FontSize="11" Foreground="#FF9D00" FontWeight="Bold" />
                                <TextBlock Text="SYNC" FontSize="10" Foreground="#F0F4F8" FontWeight="Bold" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Technical Indicators & Chart Controls Toolbar Strip -->
            <Border Background="#0A0D10" BorderBrush="#242A34" BorderThickness="1" Padding="10,6">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    
                    <!-- Left: Navigation Hotkeys Notice -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <TextBlock Text="NAVIGATION:" FontSize="9" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#8B949E" VerticalAlignment="Center" />
                        <TextBlock Text="[ZOOM: CURSOR WHEEL]" FontSize="9" FontFamily="Consolas, monospace" Foreground="#FF9D00" VerticalAlignment="Center" />
                        <TextBlock Text="[PAN: DRAG]" FontSize="9" FontFamily="Consolas, monospace" Foreground="#C9D1D9" VerticalAlignment="Center" />
                        <TextBlock Text="[CROSSHAIR: HOVER]" FontSize="9" FontFamily="Consolas, monospace" Foreground="#448AFF" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Center: Indicator & Overlay Toggles -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="OVERLAYS:" FontSize="9" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#8B949E" VerticalAlignment="Center" Margin="0,0,4,0" />
                        
                        <CheckBox IsChecked="{Binding ShowEma20}" Content="EMA 20" FontSize="9" FontFamily="Consolas, monospace" Foreground="#FFD700" />
                        <CheckBox IsChecked="{Binding ShowEma50}" Content="EMA 50" FontSize="9" FontFamily="Consolas, monospace" Foreground="#FF9100" />
                        <CheckBox IsChecked="{Binding ShowEma100}" Content="EMA 100" FontSize="9" FontFamily="Consolas, monospace" Foreground="#00E5FF" />
                        <CheckBox IsChecked="{Binding ShowEma200}" Content="EMA 200" FontSize="9" FontFamily="Consolas, monospace" Foreground="#E040FB" />
                        <CheckBox IsChecked="{Binding ShowStochastic}" Content="STOCH (5,3,3)" FontSize="9" FontFamily="Consolas, monospace" Foreground="#448AFF" />
                        <CheckBox IsChecked="{Binding ShowBidWalls}" Content="BID WALLS" FontSize="9" FontFamily="Consolas, monospace" Foreground="#00E676" />
                        <CheckBox IsChecked="{Binding ShowAskWalls}" Content="ASK WALLS" FontSize="9" FontFamily="Consolas, monospace" Foreground="#FF5252" />
                    </StackPanel>

                    <!-- Right: Quick Navigation Commands -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Button Name="ResetChartBtn" Classes="terminal-btn" Padding="6,2" ToolTip.Tip="Reset chart view">
                            <TextBlock Text="RESET VIEW" FontSize="8" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#8B949E" />
                        </Button>
                    </StackPanel>

                </Grid>
            </Border>

            <!-- MAIN TRADINGVIEW-STYLE CANDLESTICK & INDICATOR CHART -->
            <Border Background="#080A0D" BorderBrush="#242A34" BorderThickness="1" Padding="4">
                <Grid>
                <controls:CandlestickChartControl x:Name="MainCandlestickChart"
                                                  Height="430"
                                                  Candles="{Binding Candles}"
                                                  SweepEvents="{Binding SweepEvents}"
                                                  StructuralLevels="{Binding StructuralLevels}"
                                                  Walls="{Binding OrderBookWalls}"
                                                  Symbol="{Binding Symbol}"
                                                  Timeframe="{Binding Timeframe}"
                                                  ShowEma20="{Binding ShowEma20}"
                                                  ShowEma50="{Binding ShowEma50}"
                                                  ShowEma100="{Binding ShowEma100}"
                                                  ShowEma200="{Binding ShowEma200}"
                                                  ShowStochastic="{Binding ShowStochastic}"
                                                  ShowBidWalls="{Binding ShowBidWalls}"
                                                  ShowAskWalls="{Binding ShowAskWalls}" />
                <views:VelaChartHostView x:Name="VelaChartHost" IsVisible="{Binding UseVelaChart}" Height="430" />
                </Grid>
            </Border>

            <!-- CUMULATIVE MARKET DEPTH CHART (SEPARATE PANE) -->
            <Border Background="#080A0D" BorderBrush="#242A34" BorderThickness="1" Padding="4">
                <controls:MarketDepthChartControl Height="200"
                                                  Bids="{Binding BidsBuckets}"
                                                  Asks="{Binding AsksBuckets}"
                                                  MidPrice="{Binding MidPrice}"
                                                  SpreadBps="{Binding SpreadBps}"
                                                  AgeSeconds="{Binding OrderBookAgeSeconds}"
                                                  Status="{Binding OrderBookStatus}" />
            </Border>

            <!-- Order Book Depth & Wall Telemetry (4 Tiles) -->
            <Grid ColumnDefinitions="*,*,*,*" Margin="0,2,0,0">
                <Border Grid.Column="0" Margin="0,0,4,0" Background="#0A0D10" BorderBrush="#242A34" BorderThickness="1" Padding="10,6">
                    <StackPanel Spacing="2">
                        <TextBlock Text="CROSS-BOOK SPREAD" FontSize="9" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#8B949E" />
                        <TextBlock Text="{Binding SpreadBpsText}" FontSize="13" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#448AFF" />
                        <TextBlock Text="Tight Basis Confluence" FontSize="8" FontFamily="Consolas, monospace" Foreground="#545D68" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Margin="2,0,2,0" Background="#0A0D10" BorderBrush="#242A34" BorderThickness="1" Padding="10,6">
                    <StackPanel Spacing="2">
                        <TextBlock Text="TOP PROTECTING BID WALL" FontSize="9" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#8B949E" />
                        <TextBlock Text="{Binding BidWallLevel}" FontSize="12" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#00E676" />
                        <TextBlock Text="{Binding BidDepthText, StringFormat='Total Depth: {0}'}" FontSize="8" FontFamily="Consolas, monospace" Foreground="#545D68" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Margin="2,0,2,0" Background="#0A0D10" BorderBrush="#242A34" BorderThickness="1" Padding="10,6">
                    <StackPanel Spacing="2">
                        <TextBlock Text="TOP PROTECTING ASK WALL" FontSize="9" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#8B949E" />
                        <TextBlock Text="{Binding AskWallLevel}" FontSize="12" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#FF5252" />
                        <TextBlock Text="{Binding AskDepthText, StringFormat='Total Depth: {0}'}" FontSize="8" FontFamily="Consolas, monospace" Foreground="#545D68" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Margin="4,0,0,0" Background="#0A0D10" BorderBrush="#242A34" BorderThickness="1" Padding="10,6">
                    <StackPanel Spacing="2">
                        <TextBlock Text="ORDER BOOK FEED AGE" FontSize="9" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#8B949E" />
                        <TextBlock Text="{Binding OrderBookAgeText}" FontSize="13" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#F0F4F8" />
                        <TextBlock Text="{Binding OrderBookStatus, StringFormat='Status: {0}'}" FontSize="8" FontFamily="Consolas, monospace" Foreground="#00E676" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Wall Inspector Strip -->
            <Border Background="#0C1015" BorderBrush="#242A34" BorderThickness="1" Padding="10,6">
                <Grid ColumnDefinitions="Auto,*">
                    <TextBlock Grid.Column="0" Text="WALL INSPECTOR:" FontSize="9" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#FF9D00" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding SelectedWallDetails}" FontSize="9" FontFamily="Consolas, monospace" Foreground="#C9D1D9" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- ORDER BOOK DEPTH & LIQUIDITY MAP (WALLS TABLE) -->
            <Border Background="#0E1217" BorderBrush="#242A34" BorderThickness="1" Padding="12,10">
                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="▶ ORDER BOOK DEPTH &amp; LIQUIDITY MAP (PROTECTING WALL CANDIDATES)" FontSize="11" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#FF9D00" />
                        <TextBlock Grid.Column="1" Text="Click any wall to inspect price and notional on chart" FontSize="8" FontFamily="Consolas, monospace" Foreground="#8B949E" />
                    </Grid>
                    
                    <!-- Table Header -->
                    <Border Background="#161B22" BorderBrush="#242A34" BorderThickness="1" Padding="8,5">
                        <Grid ColumnDefinitions="80,120,140,100,120,*">
                            <TextBlock Grid.Column="0" Text="SIDE" FontSize="9" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#FF9D00" />
                            <TextBlock Grid.Column="1" Text="PRICE LEVEL" FontSize="9" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#FF9D00" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="2" Text="NOTIONAL (USDT)" FontSize="9" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#FF9D00" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="3" Text="DISTANCE" FontSize="9" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#FF9D00" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="4" Text="QUANTITY" FontSize="9" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#FF9D00" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="5" Text="CONTRIBUTING VENUE" FontSize="9" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#FF9D00" Margin="10,0,0,0" />
                        </Grid>
                    </Border>

                    <ListBox ItemsSource="{Binding OrderBookWalls}" 
                             SelectedItem="{Binding SelectedWall}"
                             Background="Transparent" 
                             BorderThickness="0" 
                             MaxHeight="180">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="models:OrderBookWallDto">
                                <Border BorderBrush="#1C212A" BorderThickness="0,0,0,1" Padding="4,4">
                                    <Grid ColumnDefinitions="80,120,140,100,120,*">
                                        <TextBlock Grid.Column="0" Text="{Binding Side}" FontSize="10" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#448AFF" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding FormattedPrice}" FontSize="10" FontFamily="Consolas, monospace" Foreground="#F0F4F8" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding FormattedNotional}" FontSize="10" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#00E676" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3" Text="{Binding FormattedDistance}" FontSize="10" FontFamily="Consolas, monospace" Foreground="#FFB300" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="4" Text="{Binding Quantity, StringFormat='{}{0:F4}'}" FontSize="10" FontFamily="Consolas, monospace" Foreground="#8B949E" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="5" Text="{Binding Venue, TargetNullValue='Combined'}" FontSize="9" FontFamily="Consolas, monospace" Foreground="#8B949E" VerticalAlignment="Center" Margin="10,0,0,0" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>

            <!-- 15M / 1H SWEEP & RECLAIM EVENTS -->
            <Border Background="#0E1217" BorderBrush="#242A34" BorderThickness="1" Padding="12,10">
                <StackPanel Spacing="8">
                    <TextBlock Text="▶ DETECTED LIQUIDITY SWEEPS &amp; RECLAIMS (SOURCE: /api/chart/liquidity_layers)" FontSize="11" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#448AFF" />
                    
                    <!-- Table Header -->
                    <Border Background="#161B22" BorderBrush="#242A34" BorderThickness="1" Padding="8,5">
                        <Grid ColumnDefinitions="110,160,80,120,120,*">
                            <TextBlock Grid.Column="0" Text="TIME (UTC)" FontSize="9" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#FF9D00" />
                            <TextBlock Grid.Column="1" Text="EVENT ID" FontSize="9" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#FF9D00" />
                            <TextBlock Grid.Column="2" Text="SIDE" FontSize="9" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#FF9D00" />
                            <TextBlock Grid.Column="3" Text="SWEEP PRICE" FontSize="9" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#FF9D00" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="4" Text="RECLAIM PRICE" FontSize="9" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#FF9D00" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="5" Text="SWEEP VOLUME (USDT)" FontSize="9" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#FF9D00" HorizontalAlignment="Right" Margin="0,0,10,0" />
                        </Grid>
                    </Border>

                    <ListBox ItemsSource="{Binding SweepEvents}" Background="Transparent" BorderThickness="0" MaxHeight="160">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="models:SweepEventDto">
                                <Border BorderBrush="#1C212A" BorderThickness="0,0,0,1" Padding="4,4">
                                    <Grid ColumnDefinitions="110,160,80,120,120,*">
                                        <TextBlock Grid.Column="0" Text="{Binding EventTimeUtc}" FontSize="10" FontFamily="Consolas, monospace" Foreground="#C9D1D9" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding EventId}" FontSize="10" FontFamily="Consolas, monospace" Foreground="#545D68" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding Side}" FontSize="10" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#FF5252" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3" Text="{Binding SweepPrice, StringFormat='${0:F4}'}" FontSize="10" FontFamily="Consolas, monospace" Foreground="#FFB300" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="4" Text="{Binding ReclaimPrice, StringFormat='${0:F4}'}" FontSize="10" FontFamily="Consolas, monospace" Foreground="#00E676" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="5" Text="{Binding VolumeUsdt, StringFormat='${0:N0}'}" FontSize="10" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#448AFF" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>

            <!-- Candlestick Bar Overview -->
            <Border Background="#0E1217" BorderBrush="#242A34" BorderThickness="1" Padding="12,10">
                <StackPanel Spacing="8">
                    <TextBlock Text="▶ HISTORICAL CANDLESTICK BARS (RECENT 100 OHLCV SAMPLES)" FontSize="11" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#C9D1D9" />
                    
                    <!-- Table Header -->
                    <Border Background="#161B22" BorderBrush="#242A34" BorderThickness="1" Padding="8,5">
                        <Grid ColumnDefinitions="180,100,100,100,100,110,*">
                            <TextBlock Grid.Column="0" Text="TIME (UTC)" FontSize="9" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#FF9D00" />
                            <TextBlock Grid.Column="1" Text="OPEN" FontSize="9" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#FF9D00" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="2" Text="HIGH" FontSize="9" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#FF9D00" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="3" Text="LOW" FontSize="9" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#FF9D00" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="4" Text="CLOSE" FontSize="9" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#FF9D00" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="5" Text="VOLUME" FontSize="9" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#FF9D00" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="6" Text="QUOTE VOLUME (USDT)" FontSize="9" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#FF9D00" HorizontalAlignment="Right" Margin="0,0,10,0" />
                        </Grid>
                    </Border>

                    <ListBox ItemsSource="{Binding Candles}" Background="Transparent" BorderThickness="0" MaxHeight="180">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="models:KlineDto">
                                <Border BorderBrush="#1C212A" BorderThickness="0,0,0,1" Padding="4,4">
                                    <Grid ColumnDefinitions="180,100,100,100,100,110,*">
                                        <TextBlock Grid.Column="0" Text="{Binding DatetimeUtc}" FontSize="10" FontFamily="Consolas, monospace" Foreground="#C9D1D9" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Open, StringFormat='${0:F4}'}" FontSize="10" FontFamily="Consolas, monospace" Foreground="#8B949E" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding High, StringFormat='${0:F4}'}" FontSize="10" FontFamily="Consolas, monospace" Foreground="#00E676" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3" Text="{Binding Low, StringFormat='${0:F4}'}" FontSize="10" FontFamily="Consolas, monospace" Foreground="#FF5252" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="4" Text="{Binding Close, StringFormat='${0:F4}'}" FontSize="10" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#F0F4F8" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="5" Text="{Binding Volume, StringFormat='{}{0:F4}'}" FontSize="10" FontFamily="Consolas, monospace" Foreground="#8B949E" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="6" Text="{Binding QuoteVolume, StringFormat='${0:N0}'}" FontSize="10" FontFamily="Consolas, monospace" Foreground="#448AFF" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
