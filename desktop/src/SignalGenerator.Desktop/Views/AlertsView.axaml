<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SignalGenerator.Desktop.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
             x:Class="SignalGenerator.Desktop.Views.AlertsView"
             x:DataType="vm:AlertsViewModel">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16" Margin="24">
            
            <TextBlock Text="Signal Alerts &amp; Notification Dispatch" 
                       FontSize="22" 
                       FontWeight="Bold" 
                       Foreground="#F0F6FC" />
            <TextBlock Text="Discord webhooks, real-time alert history, and trigger notifications" 
                       FontSize="13" 
                       Foreground="#8B949E" 
                       Margin="0,0,0,8" />

            <Grid ColumnDefinitions="*,*" Margin="0,8,0,0">
                <Border Grid.Column="0" Margin="0,0,8,0" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="8">
                        <TextBlock Text="DISCORD WEBHOOK STATUS" FontSize="11" FontWeight="Bold" Foreground="#8B949E" />
                        <TextBlock Text="{Binding DiscordWebhookStatus}" FontSize="18" FontWeight="Bold" Foreground="#3FB950" />
                        <TextBlock Text="Outbound notifications enabled for validated SMC setups" FontSize="11" Foreground="#8B949E" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Margin="8,0,0,0" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="8">
                        <TextBlock Text="PENDING SIGNALS" FontSize="11" FontWeight="Bold" Foreground="#8B949E" />
                        <TextBlock Text="{Binding ActiveAlertsCount}" FontSize="18" FontWeight="Bold" Foreground="#58A6FF" />
                        <TextBlock Text="Real-time alert queues ready for dispatch" FontSize="11" Foreground="#8B949E" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock Text="RECENT DISPATCH LOG" FontSize="11" FontWeight="Bold" Foreground="#8B949E" />
                    <TextBlock Text="{Binding LatestAlertMessage}" FontSize="13" FontFamily="Consolas, monospace" Foreground="#C9D1D9" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
