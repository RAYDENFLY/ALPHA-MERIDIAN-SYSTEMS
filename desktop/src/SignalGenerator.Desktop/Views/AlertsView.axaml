<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SignalGenerator.Desktop.ViewModels"
             xmlns:models="using:SignalGenerator.Desktop.Models"
             mc:Ignorable="d" d:DesignWidth="1150" d:DesignHeight="750"
             x:Class="SignalGenerator.Desktop.Views.AlertsView"
             x:DataType="vm:AlertsViewModel"
             Background="#000000">

    <Grid RowDefinitions="Auto,Auto,*" Margin="14">
        
        <!-- Header Banner -->
        <Border Grid.Row="0" Background="#0E1217" BorderBrush="#242A34" BorderThickness="1" Padding="12,8" Margin="0,0,0,10">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0">
                    <TextBlock Text="■ PRICE ALERTS // REAL-TIME TRIGGER &amp; DISCORD NOTIFICATIONS" 
                               FontSize="12" 
                               FontWeight="Bold" 
                               FontFamily="Consolas, monospace" 
                               Foreground="#FF9D00" />
                    <TextBlock Text="Read-only alert monitor: price triggers, Discord webhook dispatch state, and armed levels" 
                               FontSize="10" 
                               FontFamily="Consolas, monospace" 
                               Foreground="#8B949E" 
                               Margin="0,2,0,0" />
                </StackPanel>

                <Button Grid.Column="1" 
                        Command="{Binding LoadAlertsCommand}" 
                        Classes="terminal-btn"
                        Padding="10,4"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="↻" FontSize="11" Foreground="#FF9D00" FontWeight="Bold" />
                        <TextBlock Text="SYNC ALERTS" FontSize="10" Foreground="#F0F4F8" FontWeight="Bold" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Summary Strip -->
        <Grid Grid.Row="1" ColumnDefinitions="*,*,*" Margin="0,0,0,10">
            
            <Border Grid.Column="0" Margin="0,0,4,0" Background="#0A0D10" BorderBrush="#242A34" BorderThickness="1" Padding="10,6">
                <StackPanel Spacing="2">
                    <TextBlock Text="DISCORD WEBHOOK STATUS" FontSize="9" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#8B949E" />
                    <TextBlock Text="{Binding DiscordWebhookStatus}" FontSize="11" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#00E676" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Margin="2,0,2,0" Background="#0A0D10" BorderBrush="#242A34" BorderThickness="1" Padding="10,6">
                <StackPanel Spacing="2">
                    <TextBlock Text="ACTIVE TRIGGER ALERTS" FontSize="9" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#8B949E" />
                    <TextBlock Text="{Binding ActiveAlertsCount}" FontSize="14" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#FF9D00" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Margin="4,0,0,0" Background="#0A0D10" BorderBrush="#242A34" BorderThickness="1" Padding="10,6">
                <StackPanel Spacing="2">
                    <TextBlock Text="LAST SYNC TIME" FontSize="9" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#8B949E" />
                    <TextBlock Text="{Binding LastRefreshUtc}" FontSize="13" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#F0F4F8" />
                </StackPanel>
            </Border>

        </Grid>

        <!-- Alerts Table Container -->
        <Border Grid.Row="2" Background="#0A0D10" BorderBrush="#242A34" BorderThickness="1">
            <Grid RowDefinitions="Auto,*">
                
                <!-- Table Header -->
                <Border Grid.Row="0" Background="#0E1217" BorderBrush="#242A34" BorderThickness="0,0,0,1" Padding="10,6">
                    <Grid ColumnDefinitions="120,110,130,120,130,100,*">
                        <TextBlock Grid.Column="0" Text="ALERT ID" FontSize="9" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#FF9D00" />
                        <TextBlock Grid.Column="1" Text="SYMBOL" FontSize="9" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#FF9D00" />
                        <TextBlock Grid.Column="2" Text="TARGET PRICE" FontSize="9" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#FF9D00" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="3" Text="DIRECTION" FontSize="9" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#FF9D00" HorizontalAlignment="Center" />
                        <TextBlock Grid.Column="4" Text="LAST CHECKED" FontSize="9" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#FF9D00" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="5" Text="STATUS" FontSize="9" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#FF9D00" HorizontalAlignment="Center" />
                        <TextBlock Grid.Column="6" Text="NOTES" FontSize="9" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#FF9D00" Margin="10,0,0,0" />
                    </Grid>
                </Border>

                <!-- Alerts List -->
                <ListBox Grid.Row="1" 
                         ItemsSource="{Binding Alerts}" 
                         Background="Transparent" 
                         BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="models:AlertItemDto">
                            <Border BorderBrush="#141920" BorderThickness="0,0,0,1" Padding="6,6">
                                <Grid ColumnDefinitions="120,110,130,120,130,100,*">
                                    <TextBlock Grid.Column="0" Text="{Binding AlertId}" FontSize="10" FontFamily="Consolas, monospace" Foreground="#545D68" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Symbol}" FontSize="11" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#F0F4F8" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding TargetPrice, StringFormat='${0:F4}'}" FontSize="11" FontFamily="Consolas, monospace" Foreground="#FF9D00" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{Binding Direction}" FontSize="10" FontFamily="Consolas, monospace" Foreground="#448AFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="4" Text="{Binding LastCheckedPrice, StringFormat='${0:F4}'}" FontSize="10" FontFamily="Consolas, monospace" Foreground="#8B949E" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    
                                    <Border Grid.Column="5" Background="#141920" BorderBrush="#00E676" BorderThickness="1" Padding="4,1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Status}" FontSize="9" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#00E676" />
                                    </Border>

                                    <TextBlock Grid.Column="6" Text="{Binding Note}" FontSize="10" FontFamily="Consolas, monospace" Foreground="#8B949E" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="10,0,0,0" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

            </Grid>
        </Border>

    </Grid>

</UserControl>
