<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SignalGenerator.Desktop.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1150" d:DesignHeight="750"
             x:Class="SignalGenerator.Desktop.Views.OverviewView"
             x:DataType="vm:OverviewViewModel"
             Background="#000000">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="10" Margin="14">
            
            <!-- Terminal Workspace Banner -->
            <Border Background="#0E1217" BorderBrush="#242A34" BorderThickness="1" Padding="12,8">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="■ OVERVIEW // EXECUTIVE EXECUTION &amp; RISK TELEMETRY" 
                                   FontSize="12" 
                                   FontWeight="Bold" 
                                   FontFamily="Consolas, monospace" 
                                   Foreground="#FF9D00" />
                        <TextBlock Text="Real-time multi-process telemetry, exchange position reconciliation, and risk invariant gates" 
                                   FontSize="10" 
                                   FontFamily="Consolas, monospace" 
                                   Foreground="#8B949E" 
                                   Margin="0,2,0,0" />
                    </StackPanel>

                    <Button Grid.Column="1" 
                            Command="{Binding RefreshNowCommand}" 
                            Classes="terminal-btn"
                            Padding="10,4"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="↻" FontSize="11" Foreground="#FF9D00" FontWeight="Bold" />
                            <TextBlock Text="SYNC TELEMETRY" FontSize="10" Foreground="#F0F4F8" FontWeight="Bold" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Top Metric Tiles (6-Column Dense Grid) -->
            <Grid ColumnDefinitions="*,*,*,*,*,*" Margin="0,2,0,0">
                
                <!-- Tile 1: Session Status -->
                <Border Grid.Column="0" Margin="0,0,4,0" Background="#0A0D10" BorderBrush="#242A34" BorderThickness="1" Padding="10,8">
                    <StackPanel Spacing="4">
                        <TextBlock Text="[01] SESSION STATE" FontSize="9" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#8B949E" />
                        <TextBlock Text="{Binding SessionState}" FontSize="14" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="{Binding SessionStateColor}" />
                        <TextBlock Text="{Binding Mode}" FontSize="10" FontFamily="Consolas, monospace" Foreground="#448AFF" />
                        <TextBlock Text="{Binding SessionId, StringFormat='ID: {0}'}" FontSize="9" FontFamily="Consolas, monospace" Foreground="#545D68" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>

                <!-- Tile 2: Entries Capacity -->
                <Border Grid.Column="1" Margin="2,0,2,0" Background="#0A0D10" BorderBrush="#242A34" BorderThickness="1" Padding="10,8">
                    <StackPanel Spacing="4">
                        <TextBlock Text="[02] ENTRIES PLACED" FontSize="9" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#8B949E" />
                        <TextBlock Text="{Binding EntriesPlacedDisplay}" FontSize="14" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#F0F4F8" />
                        <TextBlock Text="{Binding GlobalLockState, StringFormat='LOCK: {0}'}" FontSize="10" FontFamily="Consolas, monospace" Foreground="#FFB300" />
                        <TextBlock Text="{Binding GlobalLockSymbol, StringFormat='SYM: {0}'}" FontSize="9" FontFamily="Consolas, monospace" Foreground="#545D68" />
                    </StackPanel>
                </Border>

                <!-- Tile 3: Total Equity -->
                <Border Grid.Column="2" Margin="2,0,2,0" Background="#0A0D10" BorderBrush="#242A34" BorderThickness="1" Padding="10,8">
                    <StackPanel Spacing="4">
                        <TextBlock Text="[03] TOTAL EQUITY" FontSize="9" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#8B949E" />
                        <TextBlock Text="{Binding TotalEquityDisplay}" FontSize="14" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#448AFF" />
                        <TextBlock Text="{Binding AccountStatus}" FontSize="10" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="{Binding AccountStatusColor}" />
                        <TextBlock Text="USDT PERP" FontSize="9" FontFamily="Consolas, monospace" Foreground="#545D68" />
                    </StackPanel>
                </Border>

                <!-- Tile 4: Available Balance -->
                <Border Grid.Column="3" Margin="2,0,2,0" Background="#0A0D10" BorderBrush="#242A34" BorderThickness="1" Padding="10,8">
                    <StackPanel Spacing="4">
                        <TextBlock Text="[04] AVAILABLE BAL" FontSize="9" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#8B949E" />
                        <TextBlock Text="{Binding AvailableBalanceDisplay}" FontSize="14" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#00E676" />
                        <TextBlock Text="{Binding UsedMarginDisplay, StringFormat='USED: {0}'}" FontSize="10" FontFamily="Consolas, monospace" Foreground="#8B949E" />
                        <TextBlock Text="{Binding OpenPositionsCount, StringFormat='OPEN POS: {0}'}" FontSize="9" FontFamily="Consolas, monospace" Foreground="#545D68" />
                    </StackPanel>
                </Border>

                <!-- Tile 5: Scanner Health -->
                <Border Grid.Column="4" Margin="2,0,2,0" Background="#0A0D10" BorderBrush="#242A34" BorderThickness="1" Padding="10,8">
                    <StackPanel Spacing="4">
                        <TextBlock Text="[05] SCANNER STATE" FontSize="9" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#8B949E" />
                        <TextBlock Text="{Binding ScannerState}" FontSize="14" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#F0F4F8" />
                        <TextBlock Text="{Binding ScannerProcessStatus, StringFormat='STATUS: {0}'}" FontSize="10" FontFamily="Consolas, monospace" Foreground="#00E676" />
                        <TextBlock Text="{Binding ScanCount, StringFormat='CYCLES: {0}'}" FontSize="9" FontFamily="Consolas, monospace" Foreground="#545D68" />
                    </StackPanel>
                </Border>

                <!-- Tile 6: Preflight Audit -->
                <Border Grid.Column="5" Margin="4,0,0,0" Background="#0A0D10" BorderBrush="#242A34" BorderThickness="1" Padding="10,8">
                    <StackPanel Spacing="4">
                        <TextBlock Text="[06] PREFLIGHT" FontSize="9" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#8B949E" />
                        <TextBlock Text="{Binding PreflightVerdict}" FontSize="14" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="{Binding PreflightVerdictColor}" />
                        <TextBlock Text="SMC 15M" FontSize="10" FontFamily="Consolas, monospace" Foreground="#FF9D00" />
                        <TextBlock Text="GATED EXEC" FontSize="9" FontFamily="Consolas, monospace" Foreground="#545D68" />
                    </StackPanel>
                </Border>

            </Grid>

            <!-- Middle Section: Risk Gates & AI Pipeline (2-Column Grid) -->
            <Grid ColumnDefinitions="*,*" Margin="0,4,0,0">
                
                <!-- Left: Risk Gates & Protection Invariants Table -->
                <Border Grid.Column="0" Margin="0,0,5,0" Background="#0A0D10" BorderBrush="#242A34" BorderThickness="1" Padding="12">
                    <StackPanel Spacing="10">
                        <Border BorderBrush="#242A34" BorderThickness="0,0,0,1" Padding="0,0,0,6">
                            <TextBlock Text="■ RISK GATES &amp; PROTECTION INVARIANTS" FontSize="11" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#FF9D00" />
                        </Border>

                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" Margin="0,2,0,0">
                            
                            <!-- Metric 1: Daily Loss -->
                            <Border Grid.Row="0" Grid.Column="0" Background="#0E1217" BorderBrush="#1C212A" BorderThickness="1" Padding="10,8" Margin="0,0,4,6">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Daily Loss Used / Limit" FontSize="9" FontFamily="Consolas, monospace" Foreground="#8B949E" />
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="{Binding DailyLossUsedDisplay}" FontSize="13" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#F0F4F8" />
                                        <TextBlock Text="/" FontSize="13" Foreground="#8B949E" IsVisible="{Binding HasDailyLossMetrics}" />
                                        <TextBlock Text="{Binding DailyLossLimitDisplay}" FontSize="13" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#FFB300" IsVisible="{Binding HasDailyLossMetrics}" />
                                        <TextBlock Text="USDT" FontSize="9" FontFamily="Consolas, monospace" Foreground="#8B949E" VerticalAlignment="Bottom" IsVisible="{Binding HasDailyLossMetrics}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Metric 2: Verification Status -->
                            <Border Grid.Row="0" Grid.Column="1" Background="#0E1217" BorderBrush="#1C212A" BorderThickness="1" Padding="10,8" Margin="4,0,0,6">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Daily Loss Verification" FontSize="9" FontFamily="Consolas, monospace" Foreground="#8B949E" />
                                    <TextBlock Text="{Binding DailyLossStatus}" FontSize="13" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="{Binding DailyLossStatusColor}" />
                                </StackPanel>
                            </Border>

                            <!-- Metric 3: Effective Risk -->
                            <Border Grid.Row="1" Grid.Column="0" Background="#0E1217" BorderBrush="#1C212A" BorderThickness="1" Padding="10,8" Margin="0,0,4,6">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Effective Trade Risk" FontSize="9" FontFamily="Consolas, monospace" Foreground="#8B949E" />
                                    <TextBlock Text="{Binding EffectiveTradeRiskDisplayWithUnit}" FontSize="13" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#F0F4F8" />
                                </StackPanel>
                            </Border>

                            <!-- Metric 4: Reconciliation -->
                            <Border Grid.Row="1" Grid.Column="1" Background="#0E1217" BorderBrush="#1C212A" BorderThickness="1" Padding="10,8" Margin="4,0,0,6">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Reconciliation Status" FontSize="9" FontFamily="Consolas, monospace" Foreground="#8B949E" />
                                    <TextBlock Text="{Binding ReconciliationStatus}" FontSize="13" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="{Binding ReconciliationStatusColor}" />
                                </StackPanel>
                            </Border>

                            <!-- Metric 5: Gateway Verdict -->
                            <Border Grid.Row="2" Grid.Column="0" Background="#0E1217" BorderBrush="#1C212A" BorderThickness="1" Padding="10,8" Margin="0,0,4,0">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Can Open Position" FontSize="9" FontFamily="Consolas, monospace" Foreground="#8B949E" />
                                    <TextBlock Text="{Binding CanOpenPositionDisplay}" FontSize="13" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="{Binding CanOpenPositionColor}" />
                                </StackPanel>
                            </Border>

                            <!-- Metric 6: Block Reason -->
                            <Border Grid.Row="2" Grid.Column="1" Background="#0E1217" BorderBrush="#1C212A" BorderThickness="1" Padding="10,8" Margin="4,0,0,0">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Block Reason" FontSize="9" FontFamily="Consolas, monospace" Foreground="#8B949E" />
                                    <TextBlock Text="{Binding BlockReason}" FontSize="10" FontFamily="Consolas, monospace" Foreground="#8B949E" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Right: Groq AI Auto-Hunter Pipeline & SMC Engine -->
                <Border Grid.Column="1" Margin="5,0,0,0" Background="#0A0D10" BorderBrush="#242A34" BorderThickness="1" Padding="12">
                    <StackPanel Spacing="10">
                        <Border BorderBrush="#242A34" BorderThickness="0,0,0,1" Padding="0,0,0,6">
                            <TextBlock Text="■ GROQ AI AUTO-HUNTER // 4-STAGE PIPELINE" FontSize="11" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#FF9D00" />
                        </Border>

                        <StackPanel Spacing="6">
                            
                            <!-- Stage 1 -->
                            <Border Background="#0E1217" BorderBrush="#1C212A" BorderThickness="1" Padding="10,6">
                                <Grid ColumnDefinitions="140,*">
                                    <TextBlock Grid.Column="0" Text="STAGE 1: PREFILTER" FontSize="10" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#448AFF" />
                                    <TextBlock Grid.Column="1" Text="Zero-Token Pre-Filter: Volume &gt; $500k, Spread &lt; 8 bps" FontSize="10" FontFamily="Consolas, monospace" Foreground="#C9D1D9" />
                                </Grid>
                            </Border>

                            <!-- Stage 2 -->
                            <Border Background="#0E1217" BorderBrush="#1C212A" BorderThickness="1" Padding="10,6">
                                <Grid ColumnDefinitions="140,*">
                                    <TextBlock Grid.Column="0" Text="STAGE 2: SMC SWEEP" FontSize="10" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#448AFF" />
                                    <TextBlock Grid.Column="1" Text="15m Liquidity Sweeps, Dealing Range Discount/Premium Lock" FontSize="10" FontFamily="Consolas, monospace" Foreground="#C9D1D9" />
                                </Grid>
                            </Border>

                            <!-- Stage 3 -->
                            <Border Background="#0E1217" BorderBrush="#1C212A" BorderThickness="1" Padding="10,6">
                                <Grid ColumnDefinitions="140,*">
                                    <TextBlock Grid.Column="0" Text="STAGE 3: GROQ LLM" FontSize="10" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#FFB300" />
                                    <TextBlock Grid.Column="1" Text="Llama-3.3-70b Reasoning: Dynamic SL (1.20%-2.20%), $0.20 Risk Cap" FontSize="10" FontFamily="Consolas, monospace" Foreground="#C9D1D9" />
                                </Grid>
                            </Border>

                            <!-- Stage 4 -->
                            <Border Background="#0E1217" BorderBrush="#1C212A" BorderThickness="1" Padding="10,6">
                                <Grid ColumnDefinitions="140,*">
                                    <TextBlock Grid.Column="0" Text="STAGE 4: RATCHET" FontSize="10" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#00E676" />
                                    <TextBlock Grid.Column="1" Text="3-Tier Dynamic SL Ratchet + Structural Adaptive TP Management" FontSize="10" FontFamily="Consolas, monospace" Foreground="#C9D1D9" />
                                </Grid>
                            </Border>

                        </StackPanel>

                        <!-- Invariants Footnote -->
                        <Border Background="#0E1217" BorderBrush="#1C212A" BorderThickness="1" Padding="8,5">
                            <Grid ColumnDefinitions="*,*">
                                <TextBlock Grid.Column="0" Text="STRATEGY: 15M_SWEEP_RECLAIM_SMC" FontSize="9" FontFamily="Consolas, monospace" Foreground="#FF9D00" />
                                <TextBlock Grid.Column="1" Text="INVARIANT: READ-ONLY CLIENT" FontSize="9" FontFamily="Consolas, monospace" Foreground="#00E676" HorizontalAlignment="Right" />
                            </Grid>
                        </Border>

                    </StackPanel>
                </Border>

            </Grid>

            <!-- Bottom: Verified Telemetry Audit Log Stream -->
            <Border Background="#0A0D10" BorderBrush="#242A34" BorderThickness="1" Padding="12" Margin="0,4,0,0">
                <StackPanel Spacing="6">
                    <Border BorderBrush="#242A34" BorderThickness="0,0,0,1" Padding="0,0,0,4">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="■ OPERATIONAL TELEMETRY &amp; EVENT LOG STREAM" FontSize="10" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#FF9D00" />
                            <TextBlock Grid.Column="1" Text="{Binding LastScanTime, StringFormat='LAST SCAN: {0}'}" FontSize="9" FontFamily="Consolas, monospace" Foreground="#8B949E" />
                        </Grid>
                    </Border>
                    
                    <Border Background="#0E1217" BorderBrush="#1C212A" BorderThickness="1" Padding="10,6">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{Binding LastStatusMessage}" FontSize="11" FontFamily="Consolas, monospace" Foreground="#C9D1D9" TextWrapping="Wrap" />
                            <Grid ColumnDefinitions="*,*">
                                <TextBlock Grid.Column="0" Text="SOURCE: FastAPI REST /api/inspector/live-session" FontSize="8" FontFamily="Consolas, monospace" Foreground="#545D68" />
                                <TextBlock Grid.Column="1" Text="PROVENANCE: VERIFIED DAEMON TELEMETRY" FontSize="8" FontFamily="Consolas, monospace" Foreground="#00E676" HorizontalAlignment="Right" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
