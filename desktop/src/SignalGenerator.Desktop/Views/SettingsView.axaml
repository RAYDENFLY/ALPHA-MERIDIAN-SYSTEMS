<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SignalGenerator.Desktop.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1150" d:DesignHeight="750"
             x:Class="SignalGenerator.Desktop.Views.SettingsView"
             x:DataType="vm:SettingsViewModel"
             Background="#000000">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="10" Margin="14">
            
            <!-- Header Banner -->
            <Border Background="#0E1217" BorderBrush="#242A34" BorderThickness="1" Padding="12,8">
                <StackPanel>
                    <TextBlock Text="■ TERMINAL CONFIGURATION // FASTAPI ENDPOINTS &amp; DIAGNOSTICS" 
                               FontSize="12" 
                               FontWeight="Bold" 
                               FontFamily="Consolas, monospace" 
                               Foreground="#FF9D00" />
                    <TextBlock Text="Local daemon endpoints, polling rates, and read-only architectural invariants" 
                               FontSize="10" 
                               FontFamily="Consolas, monospace" 
                               Foreground="#8B949E" 
                               Margin="0,2,0,0" />
                </StackPanel>
            </Border>

            <!-- Configuration Form Panel -->
            <Border Background="#0A0D10" BorderBrush="#242A34" BorderThickness="1" Padding="16" MaxWidth="700" HorizontalAlignment="Left">
                <StackPanel Spacing="14">
                    
                    <!-- Backend URL -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="ALPHA MERIDIAN SYSTEMS BACKEND DAEMON URL" FontSize="10" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#FF9D00" />
                        <TextBox Text="{Binding BaseUrl}" 
                                 Background="#000000" 
                                 BorderBrush="#242A34" 
                                 Foreground="#F0F4F8" 
                                 FontFamily="Consolas, monospace"
                                 FontSize="11"
                                 CornerRadius="0" 
                                 Padding="8,6" />
                        <TextBlock Text="Must point to running FastAPI daemon (default: http://127.0.0.1:8000)" FontSize="9" FontFamily="Consolas, monospace" Foreground="#545D68" />
                    </StackPanel>

                    <!-- Polling Interval -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="TELEMETRY POLLING INTERVAL (SECONDS)" FontSize="10" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#FF9D00" />
                        <NumericUpDown Value="{Binding PollingIntervalSeconds}" 
                                       Minimum="1" 
                                       Maximum="60" 
                                       Background="#000000" 
                                       BorderBrush="#242A34" 
                                       Foreground="#F0F4F8" 
                                       FontFamily="Consolas, monospace"
                                       FontSize="11"
                                       CornerRadius="0" />
                        <TextBlock Text="Frequency of real-time non-mutating GET requests for status, session, and journal" FontSize="9" FontFamily="Consolas, monospace" Foreground="#545D68" />
                    </StackPanel>

                    <!-- Auto Polling CheckBox -->
                    <CheckBox IsChecked="{Binding EnableAutoPolling}" 
                              Foreground="#F0F4F8" 
                              FontFamily="Consolas, monospace"
                              FontSize="11"
                              Content="ENABLE AUTOMATIC BACKGROUND POLLING LOOP" />

                    <!-- Invariants Notice Box -->
                    <Border Background="#0E1217" BorderBrush="#1C212A" BorderThickness="1" Padding="12,10">
                        <StackPanel Spacing="4">
                            <TextBlock Text="CLIENT ARCHITECTURAL INVARIANT" FontSize="10" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#00E676" />
                            <TextBlock Text="This Alpha Meridian Systems desktop client interacts strictly through HTTP GET requests against the FastAPI backend. All order submissions, kill switches, and strategy mutations are isolated on the server daemon to maintain live trading safety invariants." 
                                       FontSize="10" 
                                       FontFamily="Consolas, monospace" 
                                       Foreground="#8B949E" 
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- Save Action -->
                    <Button Command="{Binding SaveSettingsCommand}" 
                            Classes="terminal-btn"
                            Padding="16,8"
                            HorizontalAlignment="Left">
                        <TextBlock Text="SAVE CONFIGURATION" />
                    </Button>

                    <TextBlock Text="{Binding SaveMessage}" 
                               IsVisible="{Binding SaveMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" 
                               Foreground="#00E676" 
                               FontWeight="Bold" 
                               FontFamily="Consolas, monospace"
                               FontSize="11" />

                </StackPanel>
            </Border>

            <!-- About & Identity Panel -->
            <Border Background="#0A0D10" BorderBrush="#242A34" BorderThickness="1" Padding="16" MaxWidth="700" HorizontalAlignment="Left">
                <StackPanel Spacing="8">
                    <TextBlock Text="■ ABOUT // ALPHA MERIDIAN SYSTEMS" FontSize="11" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#FF9D00" />
                    <TextBlock Text="ALPHA MERIDIAN SYSTEMS" FontSize="14" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#F0F4F8" />
                    <TextBlock Text="by AMS Capital" FontSize="10" FontFamily="Consolas, monospace" Foreground="#448AFF" />
                    <TextBlock Text="Quantitative Intelligence · Market Intelligence · AI Research · Execution Monitoring" FontSize="9" FontFamily="Consolas, monospace" Foreground="#8B949E" />
                    
                    <Border Background="#0E1217" BorderBrush="#1C212A" BorderThickness="1" Padding="10,8" Margin="0,4,0,0">
                        <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto,Auto">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="WORKSTATION VERSION:" FontSize="9" FontFamily="Consolas, monospace" Foreground="#8B949E" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="v3.1.0-lts (Alpha Meridian)" FontSize="9" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#C9D1D9" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="TARGET FRAMEWORK:" FontSize="9" FontFamily="Consolas, monospace" Foreground="#8B949E" Margin="0,3,0,0" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text=".NET 8.0 LTS (C# 12)" FontSize="9" FontFamily="Consolas, monospace" Foreground="#C9D1D9" Margin="0,3,0,0" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="UI FRAMEWORK:" FontSize="9" FontFamily="Consolas, monospace" Foreground="#8B949E" Margin="0,3,0,0" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="Avalonia UI 11.2 (Skia-rendered)" FontSize="9" FontFamily="Consolas, monospace" Foreground="#C9D1D9" Margin="0,3,0,0" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="LEGAL &amp; COPYRIGHT:" FontSize="9" FontFamily="Consolas, monospace" Foreground="#8B949E" Margin="0,3,0,0" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="© 2026 PT Authentic Media Services. Alpha Meridian Systems is a product of AMS Capital." FontSize="9" FontFamily="Consolas, monospace" Foreground="#545D68" Margin="0,3,0,0" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
