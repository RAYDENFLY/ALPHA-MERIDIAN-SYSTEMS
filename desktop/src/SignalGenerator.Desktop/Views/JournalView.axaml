<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SignalGenerator.Desktop.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1150" d:DesignHeight="750"
             x:Class="SignalGenerator.Desktop.Views.JournalView"
             x:DataType="vm:JournalViewModel"
             Background="#000000">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="10" Margin="14">
            
            <!-- Header Banner -->
            <Border Background="#0E1217" BorderBrush="#242A34" BorderThickness="1" Padding="12,8">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="■ PERFORMANCE JOURNAL // EXECUTED TRADES &amp; ATTRIBUTION" 
                                   FontSize="12" 
                                   FontWeight="Bold" 
                                   FontFamily="Consolas, monospace" 
                                   Foreground="#FF9D00" />
                        <TextBlock Text="Verified closed trades, R-multiple attribution, exchange fill ledger, and daily capacity utilization" 
                                   FontSize="10" 
                                   FontFamily="Consolas, monospace" 
                                   Foreground="#8B949E" 
                                   Margin="0,2,0,0" />
                    </StackPanel>

                    <Button Grid.Column="1" 
                            Command="{Binding RefreshSummaryCommand}" 
                            Classes="terminal-btn"
                            Padding="10,4"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="↻" FontSize="11" Foreground="#FF9D00" FontWeight="Bold" />
                            <TextBlock Text="SYNC JOURNAL" FontSize="10" Foreground="#F0F4F8" FontWeight="Bold" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Metrics Summary Cards (4 Columns) -->
            <Grid ColumnDefinitions="*,*,*,*" Margin="0,2,0,0">
                
                <!-- Tile 1: Win Rate -->
                <Border Grid.Column="0" Margin="0,0,4,0" Background="#0A0D10" BorderBrush="#242A34" BorderThickness="1" Padding="10,6">
                    <StackPanel Spacing="2">
                        <TextBlock Text="WIN RATE" FontSize="9" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#8B949E" />
                        <TextBlock Text="{Binding WinRatePct, StringFormat='{}{0:F1}%'}" FontSize="16" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#00E676" />
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="{Binding WinsCount}" FontSize="10" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#00E676" />
                            <TextBlock Text="W /" FontSize="10" FontFamily="Consolas, monospace" Foreground="#8B949E" />
                            <TextBlock Text="{Binding LossesCount}" FontSize="10" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#FF5252" />
                            <TextBlock Text="L /" FontSize="10" FontFamily="Consolas, monospace" Foreground="#8B949E" />
                            <TextBlock Text="{Binding BreakevenCount}" FontSize="10" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#FFB300" />
                            <TextBlock Text="BE" FontSize="10" FontFamily="Consolas, monospace" Foreground="#8B949E" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Tile 2: Total Net PnL -->
                <Border Grid.Column="1" Margin="2,0,2,0" Background="#0A0D10" BorderBrush="#242A34" BorderThickness="1" Padding="10,6">
                    <StackPanel Spacing="2">
                        <TextBlock Text="TOTAL NET PNL" FontSize="9" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#8B949E" />
                        <TextBlock Text="{Binding TotalNetPnlUsd, StringFormat='${0:F4}'}" FontSize="16" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#F0F4F8" />
                        <TextBlock Text="{Binding TotalGrossPnlUsd, StringFormat='Gross: ${0:F4}'}" FontSize="10" FontFamily="Consolas, monospace" Foreground="#8B949E" />
                    </StackPanel>
                </Border>

                <!-- Tile 3: Profit Factor & Avg R -->
                <Border Grid.Column="2" Margin="2,0,2,0" Background="#0A0D10" BorderBrush="#242A34" BorderThickness="1" Padding="10,6">
                    <StackPanel Spacing="2">
                        <TextBlock Text="PROFIT FACTOR" FontSize="9" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#8B949E" />
                        <TextBlock Text="{Binding ProfitFactor, StringFormat='{}{0:F2}'}" FontSize="16" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#448AFF" />
                        <TextBlock Text="{Binding AverageRealizedR, StringFormat='Avg R: {0:F3}'}" FontSize="10" FontFamily="Consolas, monospace" Foreground="#8B949E" />
                    </StackPanel>
                </Border>

                <!-- Tile 4: Daily Entries Remaining -->
                <Border Grid.Column="3" Margin="4,0,0,0" Background="#0A0D10" BorderBrush="#242A34" BorderThickness="1" Padding="10,6">
                    <StackPanel Spacing="2">
                        <TextBlock Text="DAILY ENTRIES REMAINING" FontSize="9" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#8B949E" />
                        <TextBlock Text="{Binding RemainingEntries}" FontSize="16" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#FF9D00" />
                        <TextBlock Text="{Binding DailyFilledEntries, StringFormat='FILLED: {0} / 3'}" FontSize="10" FontFamily="Consolas, monospace" Foreground="#8B949E" />
                    </StackPanel>
                </Border>

            </Grid>

            <!-- Detailed Invariants & Risk Panel -->
            <Border Background="#0A0D10" BorderBrush="#242A34" BorderThickness="1" Padding="12">
                <StackPanel Spacing="10">
                    <Border BorderBrush="#242A34" BorderThickness="0,0,0,1" Padding="0,0,0,4">
                        <TextBlock Text="■ RECONCILIATION &amp; RISK BUDGET CAPACITY" FontSize="11" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#FF9D00" />
                    </Border>

                    <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto">
                        
                        <Border Grid.Row="0" Grid.Column="0" Background="#0E1217" BorderBrush="#1C212A" BorderThickness="1" Padding="10,8" Margin="0,0,4,6">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Total Closed Trades" FontSize="9" FontFamily="Consolas, monospace" Foreground="#8B949E" />
                                <TextBlock Text="{Binding TotalClosedTrades}" FontSize="14" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#F0F4F8" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="0" Grid.Column="1" Background="#0E1217" BorderBrush="#1C212A" BorderThickness="1" Padding="10,8" Margin="2,0,2,6">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Total Fees Paid" FontSize="9" FontFamily="Consolas, monospace" Foreground="#8B949E" />
                                <TextBlock Text="{Binding TotalFeesPaidUsd, StringFormat='${0:F4}'}" FontSize="14" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#8B949E" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="0" Grid.Column="2" Background="#0E1217" BorderBrush="#1C212A" BorderThickness="1" Padding="10,8" Margin="4,0,0,6">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Reconciliation Integrity" FontSize="9" FontFamily="Consolas, monospace" Foreground="#8B949E" />
                                <TextBlock Text="EXCHANGE_VERIFIED" FontSize="13" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#00E676" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="0" Background="#0E1217" BorderBrush="#1C212A" BorderThickness="1" Padding="10,8" Margin="0,0,4,0">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Daily Loss Used" FontSize="9" FontFamily="Consolas, monospace" Foreground="#8B949E" />
                                <TextBlock Text="{Binding DailyLossUsageUsd, StringFormat='${0:F2}'}" FontSize="14" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#F0F4F8" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="1" Background="#0E1217" BorderBrush="#1C212A" BorderThickness="1" Padding="10,8" Margin="2,0,2,0">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Daily Loss Hard Limit" FontSize="9" FontFamily="Consolas, monospace" Foreground="#8B949E" />
                                <TextBlock Text="{Binding DailyLossLimitUsd, StringFormat='${0:F2}'}" FontSize="14" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#FF9D00" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="2" Background="#0E1217" BorderBrush="#1C212A" BorderThickness="1" Padding="10,8" Margin="4,0,0,0">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Max Trade Risk Cap" FontSize="9" FontFamily="Consolas, monospace" Foreground="#8B949E" />
                                <TextBlock Text="$0.22 USDT (TARGET $0.20)" FontSize="12" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#FFB300" />
                            </StackPanel>
                        </Border>

                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
