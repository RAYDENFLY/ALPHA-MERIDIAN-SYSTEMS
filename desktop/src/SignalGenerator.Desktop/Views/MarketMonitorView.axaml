<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SignalGenerator.Desktop.ViewModels"
             xmlns:models="using:SignalGenerator.Desktop.Models"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             x:Class="SignalGenerator.Desktop.Views.MarketMonitorView"
             x:DataType="vm:MarketMonitorViewModel"
             Background="#000000">

    <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="14">
        
        <!-- Header Banner & Mode Switcher -->
        <Border Grid.Row="0" Background="#0E1217" BorderBrush="#242A34" BorderThickness="1" Padding="12,8" Margin="0,0,0,10">
            <Grid ColumnDefinitions="*,Auto,Auto">
                
                <!-- Left Title & Subtitle -->
                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="■ MARKET INTELLIGENCE" 
                                   FontSize="12" 
                                   FontWeight="Bold" 
                                   FontFamily="Consolas, monospace" 
                                   Foreground="#FF9D00" />
                        <Border Background="#141920" BorderBrush="#242A34" BorderThickness="1" Padding="5,1">
                            <TextBlock Text="{Binding WorkspaceMode}" FontSize="9" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#448AFF" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Multi-exchange normalized order book benchmark, 24h turnover, perpetual open interest, and opportunity screener" 
                               FontSize="10" 
                               FontFamily="Consolas, monospace" 
                               Foreground="#8B949E" 
                               Margin="0,2,0,0" />
                </StackPanel>

                <!-- Center Workspace Mode Switcher -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" Margin="16,0" VerticalAlignment="Center">
                    <Button Command="{Binding SetMonitorModeCommand}" 
                            Classes="terminal-btn"
                            Padding="10,5">
                        <TextBlock Text="[1] MARKET OVERVIEW" FontSize="10" FontWeight="Bold" 
                                   Foreground="{Binding IsMonitorMode, Converter={x:Null}}" />
                    </Button>
                    <Button Command="{Binding SetScreenerModeCommand}" 
                            Classes="terminal-btn"
                            Padding="10,5">
                        <TextBlock Text="[2] OPPORTUNITY SCREENER" FontSize="10" FontWeight="Bold" 
                                   Foreground="{Binding IsScreenerMode, Converter={x:Null}}" />
                    </Button>
                </StackPanel>

                <!-- Right Refresh Action -->
                <Button Grid.Column="2" 
                        Command="{Binding LoadMarketMatrixCommand}" 
                        Classes="terminal-btn"
                        Padding="12,5"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="↻" FontSize="11" Foreground="#FF9D00" FontWeight="Bold" />
                        <TextBlock Text="SYNC INTELLIGENCE" FontSize="10" Foreground="#F0F4F8" FontWeight="Bold" />
                    </StackPanel>
                </Button>

            </Grid>
        </Border>

        <!-- Summary Statistics Ribbon -->
        <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*" Margin="0,0,0,10">
            
            <Border Grid.Column="0" Margin="0,0,4,0" Background="#0A0D10" BorderBrush="#242A34" BorderThickness="1" Padding="10,6">
                <StackPanel Spacing="2">
                    <TextBlock Text="TRACKED PERPETUAL CONTRACTS" FontSize="9" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#8B949E" />
                    <TextBlock Text="{Binding TotalMarketsCount}" FontSize="14" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#448AFF" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Margin="2,0,2,0" Background="#0A0D10" BorderBrush="#242A34" BorderThickness="1" Padding="10,6">
                <StackPanel Spacing="2">
                    <TextBlock Text="TOP 24H VOLUME LEADER" FontSize="9" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#8B949E" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{Binding HighestVolumeSymbol}" FontSize="13" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#FF9D00" />
                        <TextBlock Text="{Binding HighestVolumeText}" FontSize="11" FontFamily="Consolas, monospace" Foreground="#C9D1D9" VerticalAlignment="Bottom" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Margin="2,0,2,0" Background="#0A0D10" BorderBrush="#242A34" BorderThickness="1" Padding="10,6">
                <StackPanel Spacing="2">
                    <TextBlock Text="TOP 24H GAINER" FontSize="9" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#8B949E" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{Binding TopGainerSymbol}" FontSize="13" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#00E676" />
                        <TextBlock Text="{Binding TopGainerChange}" FontSize="11" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#00E676" VerticalAlignment="Bottom" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Column="3" Margin="4,0,0,0" Background="#0A0D10" BorderBrush="#242A34" BorderThickness="1" Padding="10,6">
                <StackPanel Spacing="2">
                    <TextBlock Text="LAST SYNC TIME" FontSize="9" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#8B949E" />
                    <TextBlock Text="{Binding LastRefreshUtc}" FontSize="13" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#F0F4F8" />
                </StackPanel>
            </Border>

        </Grid>

        <!-- Filter & Search Toolbar Ribbon -->
        <Border Grid.Row="2" Background="#0A0D10" BorderBrush="#242A34" BorderThickness="1" Padding="10,8" Margin="0,0,0,10">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                
                <!-- Market Type Selector: ALL | PERPETUAL | SPOT -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="TYPE:" FontSize="9" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#8B949E" VerticalAlignment="Center" Margin="0,0,4,0" />
                    
                    <Button Command="{Binding SelectMarketTypeCommand}" CommandParameter="ALL" 
                            Classes="terminal-btn" Padding="8,4">
                        <TextBlock Text="ALL" FontSize="9" FontWeight="Bold" FontFamily="Consolas, monospace" />
                    </Button>
                    <Button Command="{Binding SelectMarketTypeCommand}" CommandParameter="PERPETUAL" 
                            Classes="terminal-btn" Padding="8,4">
                        <TextBlock Text="PERPETUAL" FontSize="9" FontWeight="Bold" FontFamily="Consolas, monospace" />
                    </Button>
                    <Button Command="{Binding SelectMarketTypeCommand}" CommandParameter="SPOT" 
                            Classes="terminal-btn" Padding="8,4">
                        <TextBlock Text="SPOT" FontSize="9" FontWeight="Bold" FontFamily="Consolas, monospace" />
                    </Button>
                </StackPanel>

                <!-- Venue Filter: ALL | ASTERDEX | BINANCE | BYBIT | HYPERLIQUID -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="VENUE:" FontSize="9" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#8B949E" VerticalAlignment="Center" Margin="0,0,4,0" />
                    
                    <Button Command="{Binding SelectVenueCommand}" CommandParameter="ALL" 
                            Classes="terminal-btn" Padding="8,4">
                        <TextBlock Text="ALL VENUES" FontSize="9" FontWeight="Bold" FontFamily="Consolas, monospace" />
                    </Button>
                    <Button Command="{Binding SelectVenueCommand}" CommandParameter="ASTERDEX" 
                            Classes="terminal-btn" Padding="8,4">
                        <TextBlock Text="ASTERDEX" FontSize="9" FontWeight="Bold" FontFamily="Consolas, monospace" />
                    </Button>
                    <Button Command="{Binding SelectVenueCommand}" CommandParameter="BINANCE" 
                            Classes="terminal-btn" Padding="8,4">
                        <TextBlock Text="BINANCE" FontSize="9" FontWeight="Bold" FontFamily="Consolas, monospace" />
                    </Button>
                    <Button Command="{Binding SelectVenueCommand}" CommandParameter="BYBIT" 
                            Classes="terminal-btn" Padding="8,4">
                        <TextBlock Text="BYBIT" FontSize="9" FontWeight="Bold" FontFamily="Consolas, monospace" />
                    </Button>
                    <Button Command="{Binding SelectVenueCommand}" CommandParameter="HYPERLIQUID" 
                            Classes="terminal-btn" Padding="8,4">
                        <TextBlock Text="HYPERLIQUID" FontSize="9" FontWeight="Bold" FontFamily="Consolas, monospace" />
                    </Button>
                </StackPanel>

                <!-- Symbol Search Box -->
                <TextBox Grid.Column="2" 
                         Text="{Binding SearchFilter}" 
                         PlaceholderText="SEARCH SYMBOL (E.G. BTC, ETH, SOL, ZEC, BZ)..." 
                         Background="#000000" 
                         BorderBrush="#242A34" 
                         Foreground="#F0F4F8" 
                         FontFamily="Consolas, monospace"
                         FontSize="11"
                         CornerRadius="0" 
                         Padding="8,5"
                         VerticalAlignment="Center"
                         Margin="0,0,10,0" />

                <!-- Screener Pagination Controls (Visible in Screener Mode) -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" IsVisible="{Binding IsScreenerMode}">
                    <Button Command="{Binding FirstPageCommand}" Classes="terminal-btn" Padding="8,4">
                        <TextBlock Text="&lt;&lt;" FontSize="9" FontWeight="Bold" />
                    </Button>
                    <Button Command="{Binding PrevPageCommand}" Classes="terminal-btn" Padding="8,4">
                        <TextBlock Text="PREV" FontSize="9" FontWeight="Bold" />
                    </Button>
                    <Border Background="#141920" BorderBrush="#242A34" BorderThickness="1" Padding="8,4" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="PAGE" FontSize="9" FontFamily="Consolas, monospace" Foreground="#8B949E" />
                            <TextBlock Text="{Binding CurrentPage}" FontSize="10" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#FF9D00" />
                            <TextBlock Text="/" FontSize="9" FontFamily="Consolas, monospace" Foreground="#8B949E" />
                            <TextBlock Text="{Binding TotalPages}" FontSize="10" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#F0F4F8" />
                        </StackPanel>
                    </Border>
                    <Button Command="{Binding NextPageCommand}" Classes="terminal-btn" Padding="8,4">
                        <TextBlock Text="NEXT" FontSize="9" FontWeight="Bold" />
                    </Button>
                </StackPanel>

            </Grid>
        </Border>

        <!-- Full-Width Consolidated Market Matrix DataGrid Table -->
        <Border Grid.Row="3" Background="#0A0D10" BorderBrush="#242A34" BorderThickness="1">
            <Grid RowDefinitions="Auto,*">
                
                <!-- Table Header Row with Sort Triggers -->
                <Border Grid.Row="0" Background="#0E1217" BorderBrush="#242A34" BorderThickness="0,0,0,1" Padding="12,6">
                    <Grid ColumnDefinitions="140,90,130,130,130,110,80,100,*">
                        <TextBlock Grid.Column="0" Text="SYMBOL" FontSize="9" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#FF9D00" />
                        <TextBlock Grid.Column="1" Text="TYPE" FontSize="9" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#FF9D00" />
                        <TextBlock Grid.Column="2" Text="BENCHMARK PRICE" FontSize="9" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#FF9D00" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="3" Text="24H VOLUME" FontSize="9" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#FF9D00" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="4" Text="OPEN INTEREST" FontSize="9" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#FF9D00" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="5" Text="24H CHANGE" FontSize="9" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#FF9D00" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="6" Text="VENUES" FontSize="9" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#FF9D00" HorizontalAlignment="Center" />
                        <TextBlock Grid.Column="7" Text="BEST SPREAD" FontSize="9" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#FF9D00" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="8" Text="DATA AGE" FontSize="9" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#FF9D00" HorizontalAlignment="Right" Margin="0,0,12,0" />
                    </Grid>
                </Border>

                <!-- Data List Items -->
                <ListBox Grid.Row="1" 
                         ItemsSource="{Binding Markets}" 
                         SelectedItem="{Binding SelectedMarket}"
                         Background="Transparent" 
                         BorderThickness="0"
                         IsVisible="{Binding !IsSpotUnavailable}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="models:MarketAssetTickerDto">
                            <Border BorderBrush="#141920" BorderThickness="0,0,0,1" Padding="8,6">
                                <Grid ColumnDefinitions="140,90,130,130,130,110,80,100,*">
                                    
                                    <!-- Symbol Column -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding NormalizedSymbol}" FontSize="11" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#F0F4F8" />
                                        <Border IsVisible="{Binding CrossListed}" Background="#1F1400" BorderBrush="#FF9D00" BorderThickness="1" Padding="3,0" VerticalAlignment="Center">
                                            <TextBlock Text="MULTI" FontSize="8" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#FF9D00" />
                                        </Border>
                                    </StackPanel>

                                    <!-- Instrument Type -->
                                    <Border Grid.Column="1" Background="#141920" BorderBrush="#242A34" BorderThickness="1" Padding="4,1" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding InstrumentType}" FontSize="8" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#448AFF" />
                                    </Border>

                                    <!-- Price -->
                                    <TextBlock Grid.Column="2" Text="{Binding FormattedPrice, StringFormat='${0}'}" FontSize="11" FontFamily="Consolas, monospace" Foreground="#F0F4F8" HorizontalAlignment="Right" VerticalAlignment="Center" />

                                    <!-- Volume -->
                                    <TextBlock Grid.Column="3" Text="{Binding FormattedVolume}" FontSize="11" FontFamily="Consolas, monospace" Foreground="#8B949E" HorizontalAlignment="Right" VerticalAlignment="Center" />

                                    <!-- Open Interest -->
                                    <TextBlock Grid.Column="4" Text="{Binding FormattedOi}" FontSize="11" FontFamily="Consolas, monospace" Foreground="#8B949E" HorizontalAlignment="Right" VerticalAlignment="Center" />

                                    <!-- 24h Change -->
                                    <TextBlock Grid.Column="5" Text="{Binding FormattedChange}" FontSize="11" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="{Binding ChangeColor}" HorizontalAlignment="Right" VerticalAlignment="Center" />

                                    <!-- Venues Count -->
                                    <TextBlock Grid.Column="6" Text="{Binding VenueCount}" FontSize="11" FontFamily="Consolas, monospace" Foreground="#C9D1D9" HorizontalAlignment="Center" VerticalAlignment="Center" />

                                    <!-- Spread -->
                                    <TextBlock Grid.Column="7" Text="{Binding FormattedSpread}" FontSize="11" FontFamily="Consolas, monospace" Foreground="#8B949E" HorizontalAlignment="Right" VerticalAlignment="Center" />

                                    <!-- Freshness -->
                                    <TextBlock Grid.Column="8" Text="{Binding DataFreshnessSeconds, StringFormat='{}{0:F1}s'}" FontSize="10" FontFamily="Consolas, monospace" Foreground="#545D68" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" />

                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Spot Market Unavailable Notice -->
                <Border Grid.Row="1" 
                        Background="#080A0D" 
                        BorderBrush="#FF9D00" 
                        BorderThickness="1" 
                        Padding="24" 
                        HorizontalAlignment="Center" 
                        VerticalAlignment="Center"
                        IsVisible="{Binding IsSpotUnavailable}">
                    <StackPanel Spacing="6" HorizontalAlignment="Center">
                        <TextBlock Text="■ SPOT MARKET DATA UNAVAILABLE" 
                                   FontSize="12" 
                                   FontWeight="Bold" 
                                   FontFamily="Consolas, monospace" 
                                   Foreground="#FF9D00" 
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding SpotUnavailableMessage}" 
                                   FontSize="10" 
                                   FontFamily="Consolas, monospace" 
                                   Foreground="#8B949E" 
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Select PERPETUAL or ALL to view real-time multi-exchange derivatives." 
                                   FontSize="9" 
                                   FontFamily="Consolas, monospace" 
                                   Foreground="#545D68" 
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Empty State Notice -->
                <Border Grid.Row="1" 
                        Background="#080A0D" 
                        BorderBrush="#242A34" 
                        BorderThickness="1" 
                        Padding="20" 
                        HorizontalAlignment="Center" 
                        VerticalAlignment="Center"
                        IsVisible="{Binding !Markets.Count}">
                    <TextBlock Text="{Binding EmptyMessage}" 
                               FontSize="11" 
                               FontWeight="Bold" 
                               FontFamily="Consolas, monospace" 
                               Foreground="#8B949E" 
                               HorizontalAlignment="Center" />
                </Border>

            </Grid>
        </Border>

    </Grid>

</UserControl>
