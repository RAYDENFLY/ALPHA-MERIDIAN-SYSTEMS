<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SignalGenerator.Desktop.ViewModels"
             xmlns:models="using:SignalGenerator.Desktop.Models"
             mc:Ignorable="d" d:DesignWidth="1150" d:DesignHeight="750"
             x:Class="SignalGenerator.Desktop.Views.MarketMonitorView"
             x:DataType="vm:MarketMonitorViewModel"
             Background="#000000">

    <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="14">
        
        <!-- Header Banner -->
        <Border Grid.Row="0" Background="#0E1217" BorderBrush="#242A34" BorderThickness="1" Padding="12,8" Margin="0,0,0,10">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0">
                    <TextBlock Text="■ MARKET MONITOR // REAL-TIME PERPETUAL FUTURES MATRIX" 
                               FontSize="12" 
                               FontWeight="Bold" 
                               FontFamily="Consolas, monospace" 
                               Foreground="#FF9D00" />
                    <TextBlock Text="Cross-venue normalized prices, 24h turnover, orderbook spreads, and open interest aggregation" 
                               FontSize="10" 
                               FontFamily="Consolas, monospace" 
                               Foreground="#8B949E" 
                               Margin="0,2,0,0" />
                </StackPanel>

                <Button Grid.Column="1" 
                        Command="{Binding LoadMarketMatrixCommand}" 
                        Classes="terminal-btn"
                        Padding="10,4"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="↻" FontSize="11" Foreground="#FF9D00" FontWeight="Bold" />
                        <TextBlock Text="SYNC MATRIX" FontSize="10" Foreground="#F0F4F8" FontWeight="Bold" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Summary Statistics Ribbon -->
        <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*" Margin="0,0,0,10">
            
            <Border Grid.Column="0" Margin="0,0,4,0" Background="#0A0D10" BorderBrush="#242A34" BorderThickness="1" Padding="10,6">
                <StackPanel Spacing="2">
                    <TextBlock Text="TRACKED PERPETUAL CONTRACTS" FontSize="9" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#8B949E" />
                    <TextBlock Text="{Binding TotalMarketsCount}" FontSize="14" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#448AFF" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Margin="2,0,2,0" Background="#0A0D10" BorderBrush="#242A34" BorderThickness="1" Padding="10,6">
                <StackPanel Spacing="2">
                    <TextBlock Text="TOP 24H VOLUME LEADER" FontSize="9" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#8B949E" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{Binding HighestVolumeSymbol}" FontSize="13" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#FF9D00" />
                        <TextBlock Text="{Binding HighestVolumeText}" FontSize="11" FontFamily="Consolas, monospace" Foreground="#C9D1D9" VerticalAlignment="Bottom" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Margin="2,0,2,0" Background="#0A0D10" BorderBrush="#242A34" BorderThickness="1" Padding="10,6">
                <StackPanel Spacing="2">
                    <TextBlock Text="TOP 24H GAINER" FontSize="9" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#8B949E" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{Binding TopGainerSymbol}" FontSize="13" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#00E676" />
                        <TextBlock Text="{Binding TopGainerChange}" FontSize="11" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#00E676" VerticalAlignment="Bottom" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Column="3" Margin="4,0,0,0" Background="#0A0D10" BorderBrush="#242A34" BorderThickness="1" Padding="10,6">
                <StackPanel Spacing="2">
                    <TextBlock Text="LAST SYNC TIME" FontSize="9" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#8B949E" />
                    <TextBlock Text="{Binding LastRefreshUtc}" FontSize="13" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#F0F4F8" />
                </StackPanel>
            </Border>

        </Grid>

        <!-- Search Bar -->
        <Border Grid.Row="2" Background="#0A0D10" BorderBrush="#242A34" BorderThickness="1" Padding="8,6" Margin="0,0,0,10">
            <Grid ColumnDefinitions="*,Auto">
                <TextBox Grid.Column="0" 
                         Text="{Binding SearchFilter}" 
                         PlaceholderText="FILTER BY TICKER SYMBOL (E.G. BTC, ETH, SOL, ZEC, BZ)..." 
                         Background="#000000" 
                         BorderBrush="#242A34" 
                         Foreground="#F0F4F8" 
                         FontFamily="Consolas, monospace"
                         FontSize="11"
                         CornerRadius="0" 
                         Padding="8,5"
                         Margin="0,0,8,0" />

                <Button Grid.Column="1" 
                        Command="{Binding LoadMarketMatrixCommand}" 
                        Classes="terminal-btn"
                        Padding="14,5">
                    <TextBlock Text="APPLY FILTER" />
                </Button>
            </Grid>
        </Border>

        <!-- Terminal Dense Data Grid Table -->
        <Border Grid.Row="3" Background="#0A0D10" BorderBrush="#242A34" BorderThickness="1">
            <Grid RowDefinitions="Auto,*">
                
                <!-- Table Header Row -->
                <Border Grid.Row="0" Background="#0E1217" BorderBrush="#242A34" BorderThickness="0,0,0,1" Padding="10,6">
                    <Grid ColumnDefinitions="140,120,130,130,110,80,90,*">
                        <TextBlock Grid.Column="0" Text="SYMBOL" FontSize="9" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#FF9D00" />
                        <TextBlock Grid.Column="1" Text="MARK PRICE" FontSize="9" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#FF9D00" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="2" Text="24H VOL (USDT)" FontSize="9" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#FF9D00" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="3" Text="OPEN INTEREST" FontSize="9" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#FF9D00" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="4" Text="24H CHANGE" FontSize="9" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#FF9D00" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="5" Text="VENUES" FontSize="9" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#FF9D00" HorizontalAlignment="Center" />
                        <TextBlock Grid.Column="6" Text="BEST SPREAD" FontSize="9" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#FF9D00" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="7" Text="SYNC AGE" FontSize="9" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#FF9D00" HorizontalAlignment="Right" Margin="0,0,10,0" />
                    </Grid>
                </Border>

                <!-- Data List Items -->
                <ListBox Grid.Row="1" 
                         ItemsSource="{Binding Markets}" 
                         Background="Transparent" 
                         BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="models:MarketAssetTickerDto">
                            <Border BorderBrush="#141920" BorderThickness="0,0,0,1" Padding="6,5">
                                <Grid ColumnDefinitions="140,120,130,130,110,80,90,*">
                                    
                                    <!-- Symbol Column -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding NormalizedSymbol}" FontSize="11" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#F0F4F8" />
                                        <Border IsVisible="{Binding CrossListed}" Background="#1F1400" BorderBrush="#FF9D00" BorderThickness="1" Padding="3,0" VerticalAlignment="Center">
                                            <TextBlock Text="MULTI" FontSize="8" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#FF9D00" />
                                        </Border>
                                    </StackPanel>

                                    <!-- Price -->
                                    <TextBlock Grid.Column="1" Text="{Binding BenchmarkPrice, StringFormat='${0:F4}'}" FontSize="11" FontFamily="Consolas, monospace" Foreground="#F0F4F8" HorizontalAlignment="Right" VerticalAlignment="Center" />

                                    <!-- Volume -->
                                    <TextBlock Grid.Column="2" Text="{Binding TotalVolume24hUsdt, StringFormat='${0:N0}'}" FontSize="11" FontFamily="Consolas, monospace" Foreground="#8B949E" HorizontalAlignment="Right" VerticalAlignment="Center" />

                                    <!-- Open Interest -->
                                    <TextBlock Grid.Column="3" Text="{Binding TotalOpenInterestUsdt, StringFormat='${0:N0}'}" FontSize="11" FontFamily="Consolas, monospace" Foreground="#8B949E" HorizontalAlignment="Right" VerticalAlignment="Center" />

                                    <!-- 24h Change -->
                                    <TextBlock Grid.Column="4" Text="{Binding PriceChange24hPct, StringFormat='{}{0:+0.00;-0.00}%'}" FontSize="11" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#00E676" HorizontalAlignment="Right" VerticalAlignment="Center" />

                                    <!-- Venues -->
                                    <TextBlock Grid.Column="5" Text="{Binding VenueCount}" FontSize="11" FontFamily="Consolas, monospace" Foreground="#C9D1D9" HorizontalAlignment="Center" VerticalAlignment="Center" />

                                    <!-- Spread -->
                                    <TextBlock Grid.Column="6" Text="{Binding BestSpreadBps, StringFormat='{}{0:F1} bps'}" FontSize="11" FontFamily="Consolas, monospace" Foreground="#8B949E" HorizontalAlignment="Right" VerticalAlignment="Center" />

                                    <!-- Freshness -->
                                    <TextBlock Grid.Column="7" Text="{Binding DataFreshnessSeconds, StringFormat='{}{0:F1}s'}" FontSize="10" FontFamily="Consolas, monospace" Foreground="#545D68" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" />

                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

            </Grid>
        </Border>

    </Grid>

</UserControl>
