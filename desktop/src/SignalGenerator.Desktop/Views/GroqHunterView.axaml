<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SignalGenerator.Desktop.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
             x:Class="SignalGenerator.Desktop.Views.GroqHunterView"
             x:DataType="vm:GroqHunterViewModel">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16" Margin="24">
            
            <TextBlock Text="Groq AI Auto-Hunter Diagnostics" 
                       FontSize="22" 
                       FontWeight="Bold" 
                       Foreground="#F0F6FC" />
            <TextBlock Text="Llama-3.3-70b-versatile pipeline telemetry, 4-stage filters, and API key vault" 
                       FontSize="13" 
                       Foreground="#8B949E" 
                       Margin="0,0,0,8" />

            <Grid ColumnDefinitions="*,*" Margin="0,8,0,0">
                <Border Grid.Column="0" Margin="0,0,8,0" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="10">
                        <TextBlock Text="INFERENCE MODEL" FontSize="11" FontWeight="Bold" Foreground="#8B949E" />
                        <TextBlock Text="{Binding ModelName}" FontSize="16" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#58A6FF" />
                        <TextBlock Text="Ultra low-latency Groq hardware provider" FontSize="11" Foreground="#8B949E" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Margin="8,0,0,0" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="10">
                        <TextBlock Text="API KEY VAULT STATUS" FontSize="11" FontWeight="Bold" Foreground="#8B949E" />
                        <TextBlock Text="{Binding KeyRotationStatus}" FontSize="16" FontWeight="Bold" Foreground="#3FB950" />
                        <TextBlock Text="Round-robin failover with rate-limit recovery" FontSize="11" Foreground="#8B949E" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 4-Stage Pipeline Card -->
            <Border Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="12">
                    <TextBlock Text="4-Stage Production Execution Pipeline" FontSize="15" FontWeight="Bold" Foreground="#F0F6FC" />

                    <Border Background="#0D1117" BorderBrush="#21262D" BorderThickness="1" CornerRadius="6" Padding="12,10">
                        <Grid ColumnDefinitions="140,*">
                            <TextBlock Grid.Column="0" Text="STAGE 1" FontWeight="Bold" Foreground="#58A6FF" />
                            <TextBlock Grid.Column="1" Text="{Binding Stage1PrefilterStatus}" FontFamily="Consolas, monospace" Foreground="#C9D1D9" />
                        </Grid>
                    </Border>

                    <Border Background="#0D1117" BorderBrush="#21262D" BorderThickness="1" CornerRadius="6" Padding="12,10">
                        <Grid ColumnDefinitions="140,*">
                            <TextBlock Grid.Column="0" Text="STAGE 2" FontWeight="Bold" Foreground="#58A6FF" />
                            <TextBlock Grid.Column="1" Text="{Binding Stage2SMCVerification}" FontFamily="Consolas, monospace" Foreground="#C9D1D9" />
                        </Grid>
                    </Border>

                    <Border Background="#0D1117" BorderBrush="#21262D" BorderThickness="1" CornerRadius="6" Padding="12,10">
                        <Grid ColumnDefinitions="140,*">
                            <TextBlock Grid.Column="0" Text="STAGE 3" FontWeight="Bold" Foreground="#D29922" />
                            <TextBlock Grid.Column="1" Text="{Binding Stage3LLMExecution}" FontFamily="Consolas, monospace" Foreground="#C9D1D9" />
                        </Grid>
                    </Border>

                    <Border Background="#0D1117" BorderBrush="#21262D" BorderThickness="1" CornerRadius="6" Padding="12,10">
                        <Grid ColumnDefinitions="140,*">
                            <TextBlock Grid.Column="0" Text="STAGE 4" FontWeight="Bold" Foreground="#3FB950" />
                            <TextBlock Grid.Column="1" Text="{Binding Stage4OrderProtection}" FontFamily="Consolas, monospace" Foreground="#C9D1D9" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
