<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SignalGenerator.Desktop.ViewModels"
             xmlns:models="using:SignalGenerator.Desktop.Models"
             mc:Ignorable="d" d:DesignWidth="1150" d:DesignHeight="750"
             x:Class="SignalGenerator.Desktop.Views.CryptoNewsView"
             x:DataType="vm:CryptoNewsViewModel"
             Background="#000000">

    <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="14">
        
        <!-- Header Banner -->
        <Border Grid.Row="0" Background="#0E1217" BorderBrush="#242A34" BorderThickness="1" Padding="12,8" Margin="0,0,0,10">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0">
                    <TextBlock Text="■ GLOBAL MARKET INTELLIGENCE // MULTI-MARKET RSS WIRE &amp; PERSISTENT DATABASE" 
                               FontSize="12" 
                               FontWeight="Bold" 
                               FontFamily="Consolas, monospace" 
                               Foreground="#FF9D00" />
                    <TextBlock Text="Persistent local SQLite storage (%LOCALAPPDATA%\AMS Capital\Alpha Meridian Systems\news.db) with isolated server-side Groq summarization" 
                               FontSize="10" 
                               FontFamily="Consolas, monospace" 
                               Foreground="#8B949E" 
                               Margin="0,2,0,0" />
                </StackPanel>

                <Button Grid.Column="1" 
                        Command="{Binding RefreshNewsCommand}" 
                        Classes="terminal-btn"
                        Padding="10,4"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="↻" FontSize="11" Foreground="#FF9D00" FontWeight="Bold" />
                        <TextBlock Text="REFRESH NEWS" FontSize="10" Foreground="#F0F4F8" FontWeight="Bold" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Source & Category Filter Ribbons -->
        <Border Grid.Row="1" Background="#0A0D10" BorderBrush="#242A34" BorderThickness="1" Padding="8,6" Margin="0,0,0,10">
            <Grid RowDefinitions="Auto,Auto">
                <!-- Source Filter & Status Strip -->
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Margin="0,0,0,6">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="SOURCES:" FontSize="9" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#8B949E" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <Button Command="{Binding FilterByPublisherCommand}" CommandParameter="ALL" Classes="terminal-btn" Padding="8,2">
                            <TextBlock Text="ALL SOURCES" FontSize="9" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#FF9D00" />
                        </Button>
                        <Button Command="{Binding FilterByPublisherCommand}" CommandParameter="CoinDesk" Classes="terminal-btn" Padding="8,2">
                            <TextBlock Text="COINDESK" FontSize="9" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#448AFF" />
                        </Button>
                        <Button Command="{Binding FilterByPublisherCommand}" CommandParameter="CoinTelegraph" Classes="terminal-btn" Padding="8,2">
                            <TextBlock Text="COINTELEGRAPH" FontSize="9" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#00E676" />
                        </Button>
                        <Button Command="{Binding FilterByPublisherCommand}" CommandParameter="Federal Reserve" Classes="terminal-btn" Padding="8,2">
                            <TextBlock Text="FEDERAL RESERVE" FontSize="9" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#FFB300" />
                        </Button>
                    </StackPanel>

                    <!-- Feed Sources Live Telemetry -->
                    <ItemsControl Grid.Column="1" ItemsSource="{Binding FeedSources}" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="8" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:FeedSourceStatusDto">
                                <Border Background="#161B22" BorderBrush="#242A34" BorderThickness="1" Padding="6,2">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="●" FontSize="8" Foreground="{Binding StatusColor}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Name}" FontSize="8" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#C9D1D9" />
                                        <TextBlock Text="{Binding Status}" FontSize="8" FontFamily="Consolas, monospace" Foreground="{Binding StatusColor}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>

                <!-- Category Filters & Isolation Banner -->
                <Grid Grid.Row="1" ColumnDefinitions="Auto,*">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="CATEGORIES:" FontSize="9" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#8B949E" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <Button Command="{Binding FilterByCategoryCommand}" CommandParameter="ALL" Classes="terminal-btn" Padding="8,2">
                            <TextBlock Text="ALL CATEGORIES" FontSize="9" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#FF9D00" />
                        </Button>
                        <Button Command="{Binding FilterByCategoryCommand}" CommandParameter="CRYPTO" Classes="terminal-btn" Padding="8,2">
                            <TextBlock Text="CRYPTO / ALTS" FontSize="9" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#00E676" />
                        </Button>
                        <Button Command="{Binding FilterByCategoryCommand}" CommandParameter="CENTRAL_BANK" Classes="terminal-btn" Padding="8,2">
                            <TextBlock Text="CENTRAL BANK / RATES" FontSize="9" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#448AFF" />
                        </Button>
                        <Button Command="{Binding FilterByCategoryCommand}" CommandParameter="DERIVATIVES" Classes="terminal-btn" Padding="8,2">
                            <TextBlock Text="DERIVATIVES" FontSize="9" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#FFB300" />
                        </Button>
                    </StackPanel>

                    <TextBlock Grid.Column="1" Text="{Binding GroqSummaryNotice}" FontSize="9" FontFamily="Consolas, monospace" Foreground="#8B949E" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </Grid>
        </Border>

        <!-- Search Bar & Date Filter Controls (Phase D) -->
        <Border Grid.Row="2" Background="#0A0D10" BorderBrush="#242A34" BorderThickness="1" Padding="8,6" Margin="0,0,0,10">
            <Grid ColumnDefinitions="*,130,130,Auto,Auto">
                <!-- Search Query Box -->
                <TextBox Grid.Column="0" 
                         Text="{Binding SearchQuery}" 
                         PlaceholderText="SEARCH HEADLINES, EXCERPTS, PUBLISHERS, ASSETS..." 
                         Background="#000000" 
                         BorderBrush="#242A34" 
                         Foreground="#F0F4F8" 
                         FontFamily="Consolas, monospace"
                         FontSize="10"
                         CornerRadius="0" 
                         Padding="6,4"
                         Margin="0,0,6,0" />

                <!-- Start Date Box -->
                <TextBox Grid.Column="1" 
                         Text="{Binding StartDateText}" 
                         PlaceholderText="START: YYYY-MM-DD" 
                         Background="#000000" 
                         BorderBrush="#242A34" 
                         Foreground="#F0F4F8" 
                         FontFamily="Consolas, monospace"
                         FontSize="10"
                         CornerRadius="0" 
                         Padding="6,4"
                         Margin="0,0,6,0" />

                <!-- End Date Box -->
                <TextBox Grid.Column="2" 
                         Text="{Binding EndDateText}" 
                         PlaceholderText="END: YYYY-MM-DD" 
                         Background="#000000" 
                         BorderBrush="#242A34" 
                         Foreground="#F0F4F8" 
                         FontFamily="Consolas, monospace"
                         FontSize="10"
                         CornerRadius="0" 
                         Padding="6,4"
                         Margin="0,0,6,0" />

                <!-- Apply Button -->
                <Button Grid.Column="3" 
                        Command="{Binding ApplySearchCommand}" 
                        Classes="terminal-btn"
                        Padding="10,4"
                        Margin="0,0,6,0">
                    <TextBlock Text="APPLY FILTER" FontSize="9" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#FF9D00" />
                </Button>

                <!-- Reset Button -->
                <Button Grid.Column="4" 
                        Command="{Binding ResetFilterCommand}" 
                        Classes="terminal-btn"
                        Padding="10,4">
                    <TextBlock Text="RESET" FontSize="9" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#8B949E" />
                </Button>
            </Grid>
        </Border>

        <!-- Main 2-Column Split: Articles Stream + Detailed Panel -->
        <Grid Grid.Row="3" ColumnDefinitions="*,440">
            
            <!-- Left: Articles List -->
            <Border Grid.Column="0" Margin="0,0,6,0" Background="#0A0D10" BorderBrush="#242A34" BorderThickness="1" Padding="10">
                <Grid RowDefinitions="Auto,*">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                        <TextBlock Text="▶ INCOMING FINANCIAL WIRE STREAM (SQLITE PERSISTED)" FontSize="10" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#FF9D00" />
                        <TextBlock Grid.Column="1" Text="{Binding ItemCount, StringFormat='{}ARTICLES: {0}'}" FontSize="9" FontFamily="Consolas, monospace" Foreground="#8B949E" />
                    </Grid>
                    
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding NewsArticles}"
                             SelectedItem="{Binding SelectedArticle}"
                             Background="Transparent"
                             BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="models:NewsArticleDto">
                                <Border BorderBrush="#1C212A" BorderThickness="0,0,0,1" Padding="6,6">
                                    <Grid RowDefinitions="Auto,Auto">
                                        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto">
                                            <Border Grid.Column="0" Background="#161B22" BorderBrush="#242A34" BorderThickness="1" Padding="4,1" Margin="0,0,6,0">
                                                <TextBlock Text="{Binding Category}" FontSize="8" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#FF9D00" />
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{Binding Publisher}" FontSize="9" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#448AFF" />
                                            <TextBlock Grid.Column="2" Text="{Binding DisplayTime}" FontSize="9" FontFamily="Consolas, monospace" Foreground="#8B949E" Margin="0,0,6,0" />
                                            <Border Grid.Column="3" Background="#161B22" BorderBrush="#242A34" BorderThickness="1" Padding="4,1">
                                                <TextBlock Text="{Binding SentimentBias}" FontSize="8" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#00E676" />
                                            </Border>
                                        </Grid>

                                        <TextBlock Grid.Row="1" Text="{Binding Title}" FontSize="11" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#F0F4F8" TextWrapping="Wrap" Margin="0,4,0,0" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Empty State Notice -->
                    <Border Grid.Row="1" 
                            Background="#080A0D" 
                            BorderBrush="#242A34" 
                            BorderThickness="1" 
                            Padding="20"
                            HorizontalAlignment="Center" 
                            VerticalAlignment="Center"
                            IsVisible="{Binding !NewsArticles.Count}">
                        <StackPanel Spacing="6" HorizontalAlignment="Center">
                            <TextBlock Text="NO ARTICLES FOUND MATCHING CURRENT FILTER" FontSize="11" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#FF9D00" HorizontalAlignment="Center" />
                            <TextBlock Text="Adjust category, search query, or date range, or click REFRESH NEWS." FontSize="9" FontFamily="Consolas, monospace" Foreground="#8B949E" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Right: Article Detail & AI Summarization -->
            <Border Grid.Column="1" Margin="6,0,0,0" Background="#0A0D10" BorderBrush="#242A34" BorderThickness="1" Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="8">
                        <TextBlock Text="■ ARTICLE INTELLIGENCE &amp; CONTEXT" FontSize="10" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#FF9D00" />
                        
                        <TextBlock Text="{Binding SelectedArticle.Title, TargetNullValue='No article selected'}" FontSize="12" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#F0F4F8" TextWrapping="Wrap" />
                        
                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Grid.Column="0" Text="SOURCE: " FontSize="9" FontFamily="Consolas, monospace" Foreground="#8B949E" />
                            <TextBlock Grid.Column="1" Text="{Binding SelectedArticle.Publisher, TargetNullValue='--'}" FontSize="9" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#448AFF" />
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Grid.Column="0" Text="PUBLISHED: " FontSize="9" FontFamily="Consolas, monospace" Foreground="#8B949E" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{Binding SelectedArticle.DisplayDateTimeUtc, TargetNullValue='--'}" FontSize="9" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#C9D1D9" />
                                <TextBlock Text="{Binding SelectedArticle.DisplayDateTimeLocal, StringFormat='{}(Local: {0})', TargetNullValue=''}" FontSize="8" FontFamily="Consolas, monospace" Foreground="#8B949E" />
                            </StackPanel>
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Grid.Column="0" Text="AFFECTED ASSETS: " FontSize="9" FontFamily="Consolas, monospace" Foreground="#8B949E" />
                            <TextBlock Grid.Column="1" Text="{Binding SelectedArticle.AffectedAssets, TargetNullValue='--'}" FontSize="9" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#00E676" />
                        </Grid>

                        <Separator Background="#242A34" Margin="0,4" />

                        <!-- Source Excerpt Box -->
                        <TextBlock Text="SOURCE EXCERPT" FontSize="9" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#8B949E" />
                        <Border Background="#06080A" BorderBrush="#1C212A" BorderThickness="1" Padding="8">
                            <TextBlock Text="{Binding SelectedArticle.Excerpt, TargetNullValue='Select an article to view content.'}" FontSize="10" FontFamily="Consolas, monospace" Foreground="#C9D1D9" TextWrapping="Wrap" LineHeight="15" />
                        </Border>

                        <!-- Dedicated Institutional AI Summary Box -->
                        <Border Background="#0D1117" BorderBrush="#FF9D00" BorderThickness="1" Padding="10" Margin="0,4,0,0" IsVisible="{Binding HasAiSummary}">
                            <StackPanel Spacing="6">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="■ INSTITUTIONAL AI SUMMARY (GROQ)" FontSize="10" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#FF9D00" />
                                    <Border Grid.Column="1" Background="#1C2128" BorderBrush="#30363D" BorderThickness="1" Padding="4,1">
                                        <TextBlock Text="{Binding AiSummaryGeneratedTime, StringFormat='{}SYNTHESIZED: {0}'}" FontSize="8" FontFamily="Consolas, monospace" Foreground="#8B949E" />
                                    </Border>
                                </Grid>
                                <TextBlock Text="{Binding AiSummaryContent}" FontSize="10" FontFamily="Consolas, monospace" Foreground="#F0F4F8" TextWrapping="Wrap" LineHeight="16" />
                            </StackPanel>
                        </Border>

                        <!-- Action Buttons: Generate Summary & Open Source (Phase D) -->
                        <Grid ColumnDefinitions="*,*" Margin="0,6,0,0">
                            <Button Grid.Column="0"
                                    Command="{Binding GenerateSummaryCommand}" 
                                    IsEnabled="{Binding !IsSummarizing}"
                                    Classes="terminal-btn"
                                    Padding="8,6"
                                    Margin="0,0,4,0">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4">
                                    <TextBlock Text="⚡" FontSize="11" Foreground="#FF9D00" />
                                    <TextBlock Text="GENERATE AI SUMMARY" FontSize="9" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#F0F4F8" />
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="1"
                                    Command="{Binding OpenSourceArticleCommand}" 
                                    Classes="terminal-btn"
                                    Padding="8,6"
                                    Margin="4,0,0,0">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4">
                                    <TextBlock Text="↗" FontSize="11" Foreground="#448AFF" FontWeight="Bold" />
                                    <TextBlock Text="OPEN SOURCE" FontSize="9" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#F0F4F8" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Border Background="#0E1217" BorderBrush="#242A34" BorderThickness="1" Padding="8" Margin="0,4,0,0">
                            <TextBlock Text="{Binding SummaryStatusText}" FontSize="9" FontFamily="Consolas, monospace" Foreground="#FFB300" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

        </Grid>
    </Grid>
</UserControl>
