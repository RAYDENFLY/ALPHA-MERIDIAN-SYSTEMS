<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SignalGenerator.Desktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
        x:Class="SignalGenerator.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="SignalGenerator Desktop Terminal — [Bloomberg Classic Edition]"
        Background="#000000"
        MinWidth="1150" MinHeight="720"
        WindowStartupLocation="CenterScreen">

    <Grid RowDefinitions="Auto,*,Auto">
        
        <!-- Bloomberg Command & Telemetry Ribbon -->
        <Border Grid.Row="0" Background="#080B0E" BorderBrush="#242A34" BorderThickness="0,0,0,1" Padding="12,6">
            <Grid ColumnDefinitions="Auto,*,Auto">
                
                <!-- Brand & Terminal ID -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="[SG // BLOOMBERG TERMINAL]" 
                               FontSize="12" 
                               FontWeight="Bold" 
                               FontFamily="Consolas, monospace" 
                               Foreground="#FF9D00" 
                               VerticalAlignment="Center" />
                    <Border Background="#141920" BorderBrush="#242A34" BorderThickness="1" Padding="5,2" VerticalAlignment="Center">
                        <TextBlock Text="LIVE_MICRO_V1" FontSize="9" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#448AFF" />
                    </Border>
                    <Border Background="#141920" BorderBrush="#242A34" BorderThickness="1" Padding="5,2" VerticalAlignment="Center">
                        <TextBlock Text="ASTERDEX" FontSize="9" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#00E676" />
                    </Border>
                </StackPanel>

                <!-- Center Telemetry Strip -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                    
                    <!-- Connection Status -->
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Ellipse Width="6" Height="6" Fill="{Binding ConnectionStatusColor}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ConnectionStatusText}" FontSize="10" FontWeight="Bold" 
                                   FontFamily="Consolas, monospace" Foreground="{Binding ConnectionStatusColor}" VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Text="|" Foreground="#363E4D" VerticalAlignment="Center" />

                    <!-- Mode -->
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="MODE:" FontSize="10" FontFamily="Consolas, monospace" Foreground="#8B949E" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Mode}" FontSize="10" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="{Binding ModeColor}" VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Text="|" Foreground="#363E4D" VerticalAlignment="Center" />

                    <!-- Session -->
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="SESSION:" FontSize="10" FontFamily="Consolas, monospace" Foreground="#8B949E" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding SessionState}" FontSize="10" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="{Binding SessionStateColor}" VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Text="|" Foreground="#363E4D" VerticalAlignment="Center" />

                    <!-- Lock -->
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="LOCK:" FontSize="10" FontFamily="Consolas, monospace" Foreground="#8B949E" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding LockBadge}" FontSize="10" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="{Binding LockBadgeColor}" VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Text="|" Foreground="#363E4D" VerticalAlignment="Center" />

                    <!-- Equity -->
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="EQUITY:" FontSize="10" FontFamily="Consolas, monospace" Foreground="#8B949E" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding TotalEquityText}" FontSize="10" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#F0F4F8" VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Text="|" Foreground="#363E4D" VerticalAlignment="Center" />

                    <!-- Available -->
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="AVAIL:" FontSize="10" FontFamily="Consolas, monospace" Foreground="#8B949E" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding AvailableBalanceText}" FontSize="10" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#F0F4F8" VerticalAlignment="Center" />
                    </StackPanel>

                </StackPanel>

                <!-- Right Refresh & Timestamp -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="SYNC" FontSize="8" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#8B949E" HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding LastPollTimestamp}" FontSize="10" FontFamily="Consolas, monospace" Foreground="#C9D1D9" HorizontalAlignment="Right" />
                    </StackPanel>

                    <Button Command="{Binding RefreshAllCommand}" 
                            Classes="terminal-btn"
                            Padding="8,4">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="↻" FontSize="11" Foreground="#FF9D00" FontWeight="Bold" />
                            <TextBlock Text="&lt;F5&gt; POLL" FontSize="10" Foreground="#F0F4F8" FontWeight="Bold" />
                        </StackPanel>
                    </Button>
                </StackPanel>

            </Grid>
        </Border>

        <!-- Main Workspace Grid: Bloomberg Rail + Content -->
        <Grid Grid.Row="1" ColumnDefinitions="210,*">
            
            <!-- Left Bloomberg Navigation Rail -->
            <Border Grid.Column="0" Background="#06080A" BorderBrush="#242A34" BorderThickness="0,0,1,0" Padding="0,10">
                <Grid RowDefinitions="Auto,*,Auto">
                    
                    <!-- Directory Header -->
                    <Border Grid.Row="0" BorderBrush="#242A34" BorderThickness="0,0,0,1" Padding="12,0,12,8" Margin="0,0,0,6">
                        <TextBlock Text="■ TERMINAL DIRECTORY" FontSize="10" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#FF9D00" />
                    </Border>

                    <!-- Navigation Keys List -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="2">
                            
                            <Button Command="{Binding NavigateCommand}" CommandParameter="Overview" 
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" 
                                    Background="Transparent" BorderThickness="0" CornerRadius="0" Padding="12,8">
                                <Grid ColumnDefinitions="32,*">
                                    <TextBlock Grid.Column="0" Text="&lt;F1&gt;" FontSize="10" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#FF9D00" />
                                    <TextBlock Grid.Column="1" Text="OVERVIEW" FontSize="11" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#F0F4F8" />
                                </Grid>
                            </Button>

                            <Button Command="{Binding NavigateCommand}" CommandParameter="MarketMonitor" 
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" 
                                    Background="Transparent" BorderThickness="0" CornerRadius="0" Padding="12,8">
                                <Grid ColumnDefinitions="32,*">
                                    <TextBlock Grid.Column="0" Text="&lt;F2&gt;" FontSize="10" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#FF9D00" />
                                    <TextBlock Grid.Column="1" Text="MARKET MONITOR" FontSize="11" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#F0F4F8" />
                                </Grid>
                            </Button>

                            <Button Command="{Binding NavigateCommand}" CommandParameter="Screener" 
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" 
                                    Background="Transparent" BorderThickness="0" CornerRadius="0" Padding="12,8">
                                <Grid ColumnDefinitions="32,*">
                                    <TextBlock Grid.Column="0" Text="&lt;F3&gt;" FontSize="10" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#FF9D00" />
                                    <TextBlock Grid.Column="1" Text="MARKET SCREENER" FontSize="11" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#F0F4F8" />
                                </Grid>
                            </Button>

                            <Button Command="{Binding NavigateCommand}" CommandParameter="LiquidityIntel" 
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" 
                                    Background="Transparent" BorderThickness="0" CornerRadius="0" Padding="12,8">
                                <Grid ColumnDefinitions="32,*">
                                    <TextBlock Grid.Column="0" Text="&lt;F4&gt;" FontSize="10" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#FF9D00" />
                                    <TextBlock Grid.Column="1" Text="LIQUIDITY INTEL" FontSize="11" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#F0F4F8" />
                                </Grid>
                            </Button>

                            <Button Command="{Binding NavigateCommand}" CommandParameter="GroqHunter" 
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" 
                                    Background="Transparent" BorderThickness="0" CornerRadius="0" Padding="12,8">
                                <Grid ColumnDefinitions="32,*">
                                    <TextBlock Grid.Column="0" Text="&lt;F5&gt;" FontSize="10" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#FF9D00" />
                                    <TextBlock Grid.Column="1" Text="GROQ AUTO-HUNTER" FontSize="11" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#F0F4F8" />
                                </Grid>
                            </Button>

                            <Button Command="{Binding NavigateCommand}" CommandParameter="Journal" 
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" 
                                    Background="Transparent" BorderThickness="0" CornerRadius="0" Padding="12,8">
                                <Grid ColumnDefinitions="32,*">
                                    <TextBlock Grid.Column="0" Text="&lt;F6&gt;" FontSize="10" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#FF9D00" />
                                    <TextBlock Grid.Column="1" Text="TRADING JOURNAL" FontSize="11" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#F0F4F8" />
                                </Grid>
                            </Button>

                            <Button Command="{Binding NavigateCommand}" CommandParameter="Alerts" 
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" 
                                    Background="Transparent" BorderThickness="0" CornerRadius="0" Padding="12,8">
                                <Grid ColumnDefinitions="32,*">
                                    <TextBlock Grid.Column="0" Text="&lt;F7&gt;" FontSize="10" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#FF9D00" />
                                    <TextBlock Grid.Column="1" Text="SIGNAL ALERTS" FontSize="11" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#F0F4F8" />
                                </Grid>
                            </Button>

                            <Button Command="{Binding NavigateCommand}" CommandParameter="MarketParticipants" 
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" 
                                    Background="Transparent" BorderThickness="0" CornerRadius="0" Padding="12,8">
                                <Grid ColumnDefinitions="32,*">
                                    <TextBlock Grid.Column="0" Text="&lt;F8&gt;" FontSize="10" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#FF9D00" />
                                    <TextBlock Grid.Column="1" Text="PARTICIPANTS (COT)" FontSize="11" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#F0F4F8" />
                                </Grid>
                            </Button>

                            <Button Command="{Binding NavigateCommand}" CommandParameter="CryptoNews" 
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" 
                                    Background="Transparent" BorderThickness="0" CornerRadius="0" Padding="12,8">
                                <Grid ColumnDefinitions="32,*">
                                    <TextBlock Grid.Column="0" Text="&lt;F9&gt;" FontSize="10" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#FF9D00" />
                                    <TextBlock Grid.Column="1" Text="NEWS WIRE" FontSize="11" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#F0F4F8" />
                                </Grid>
                            </Button>

                            <Separator Background="#242A34" Margin="10,6" />

                            <Button Command="{Binding NavigateCommand}" CommandParameter="Settings" 
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" 
                                    Background="Transparent" BorderThickness="0" CornerRadius="0" Padding="12,8">
                                <Grid ColumnDefinitions="32,*">
                                    <TextBlock Grid.Column="0" Text="&lt;F10&gt;" FontSize="10" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#8B949E" />
                                    <TextBlock Grid.Column="1" Text="TERMINAL CONFIG" FontSize="11" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#C9D1D9" />
                                </Grid>
                            </Button>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- Sidebar Terminal Footer -->
                    <Border Grid.Row="2" Background="#0A0D10" BorderBrush="#242A34" BorderThickness="0,1,0,0" Padding="12,10">
                        <StackPanel Spacing="3">
                            <TextBlock Text="VENUE: ASTERDEX PERP" FontSize="9" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#FF9D00" />
                            <TextBlock Text="BRANCH: feature/avalonia-desktop" FontSize="8" FontFamily="Consolas, monospace" Foreground="#8B949E" TextWrapping="Wrap" />
                            <TextBlock Text="PROTOCOL: REST GET ONLY" FontSize="8" FontFamily="Consolas, monospace" Foreground="#00E676" />
                        </StackPanel>
                    </Border>

                </Grid>
            </Border>

            <!-- Main Workspace Canvas -->
            <ContentControl Grid.Column="1" Content="{Binding CurrentViewModel}" Background="#000000" />

        </Grid>

        <!-- Bottom Bloomberg Ticker Strip -->
        <Border Grid.Row="2" Background="#080B0E" BorderBrush="#242A34" BorderThickness="0,1,0,0" Padding="12,4">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <TextBlock Grid.Column="0" Text="■ BLOOMBERG INTELLIGENCE // REAL-TIME RESEARCH &amp; EXECUTION ENGINE" 
                           FontSize="10" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#8B949E" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="READ-ONLY FINANCIAL CLIENT — ZERO MUTATION INVARIANT ENFORCED" 
                           FontSize="9" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#00E676" VerticalAlignment="Center" />
            </Grid>
        </Border>

    </Grid>

</Window>
