<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SignalGenerator.Desktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
        x:Class="SignalGenerator.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="SignalGenerator Desktop Terminal — [.NET 8 / Avalonia]"
        Background="#0D1117"
        MinWidth="1024" MinHeight="650"
        WindowStartupLocation="CenterScreen">

    <Grid RowDefinitions="Auto,*">
        
        <!-- Top Telemetry & Invariants Header -->
        <Border Grid.Row="0" Background="#161B22" BorderBrush="#30363D" BorderThickness="0,0,0,1" Padding="16,10">
            <Grid ColumnDefinitions="Auto,*,Auto">
                
                <!-- Brand & Platform Badge -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="SignalGenerator" FontSize="16" FontWeight="Bold" Foreground="#F0F6FC" />
                    <Border Background="#1F6FEB" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                        <TextBlock Text=".NET 8 LTS" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" />
                    </Border>
                    <Border Background="#238636" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                        <TextBlock Text="Avalonia UI" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" />
                    </Border>
                </StackPanel>

                <!-- Center Telemetry Badges -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                    
                    <!-- Connection Status Badge -->
                    <Border Background="#0D1117" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="8,4">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse Width="8" Height="8" Fill="#3FB950" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ConnectionStatusText}" FontSize="11" FontWeight="Bold" 
                                       Foreground="#3FB950" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Trading Mode Badge -->
                    <Border Background="#0D1117" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="8,4">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="MODE:" FontSize="10" Foreground="#8B949E" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Mode}" FontSize="11" FontWeight="Bold" Foreground="#58A6FF" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Session State Badge -->
                    <Border Background="#0D1117" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="8,4">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="SESSION:" FontSize="10" Foreground="#8B949E" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding SessionState}" FontSize="11" FontWeight="Bold" Foreground="#3FB950" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Global Position Lock Badge -->
                    <Border Background="#0D1117" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="8,4">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="LOCK:" FontSize="10" Foreground="#8B949E" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding LockBadge}" FontSize="11" FontWeight="Bold" Foreground="#D29922" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Account Equity -->
                    <Border Background="#0D1117" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="8,4">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="EQUITY:" FontSize="10" Foreground="#8B949E" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding TotalEquityText}" FontSize="11" FontWeight="Bold" Foreground="#F0F6FC" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                </StackPanel>

                <!-- Right Polling Controls & Timestamp -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="LAST REFRESH" FontSize="9" FontWeight="Bold" Foreground="#8B949E" HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding LastPollTimestamp}" FontSize="11" FontFamily="Consolas, monospace" Foreground="#C9D1D9" HorizontalAlignment="Right" />
                    </StackPanel>

                    <Button Command="{Binding RefreshAllCommand}" 
                            Background="#21262D" 
                            BorderBrush="#30363D" 
                            BorderThickness="1" 
                            CornerRadius="6" 
                            Padding="10,6"
                            VerticalAlignment="Center">
                        <TextBlock Text="↻ Poll" FontSize="12" FontWeight="SemiBold" Foreground="#58A6FF" />
                    </Button>
                </StackPanel>

            </Grid>
        </Border>

        <!-- Main Body Grid: Sidebar + Content -->
        <Grid Grid.Row="1" ColumnDefinitions="220,*">
            
            <!-- Left Sidebar Navigation -->
            <Border Grid.Column="0" Background="#161B22" BorderBrush="#30363D" BorderThickness="0,0,1,0" Padding="12,16">
                <Grid RowDefinitions="*,Auto">
                    
                    <!-- Navigation Buttons List -->
                    <StackPanel Grid.Row="0" Spacing="6">
                        
                        <Button Command="{Binding NavigateCommand}" CommandParameter="Overview" 
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" 
                                Background="Transparent" CornerRadius="6" Padding="12,10">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="⊞" FontSize="14" Foreground="#58A6FF" />
                                <TextBlock Text="Overview" FontSize="13" FontWeight="SemiBold" Foreground="#F0F6FC" />
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding NavigateCommand}" CommandParameter="Screener" 
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" 
                                Background="Transparent" CornerRadius="6" Padding="12,10">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="☷" FontSize="14" Foreground="#58A6FF" />
                                <TextBlock Text="Market Screener" FontSize="13" FontWeight="SemiBold" Foreground="#F0F6FC" />
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding NavigateCommand}" CommandParameter="Journal" 
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" 
                                Background="Transparent" CornerRadius="6" Padding="12,10">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="📄" FontSize="14" Foreground="#58A6FF" />
                                <TextBlock Text="Trade Journal" FontSize="13" FontWeight="SemiBold" Foreground="#F0F6FC" />
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding NavigateCommand}" CommandParameter="LiquidityIntel" 
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" 
                                Background="Transparent" CornerRadius="6" Padding="12,10">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="🌊" FontSize="14" Foreground="#58A6FF" />
                                <TextBlock Text="Liquidity Intel" FontSize="13" FontWeight="SemiBold" Foreground="#F0F6FC" />
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding NavigateCommand}" CommandParameter="Alerts" 
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" 
                                Background="Transparent" CornerRadius="6" Padding="12,10">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="🔔" FontSize="14" Foreground="#58A6FF" />
                                <TextBlock Text="Signal Alerts" FontSize="13" FontWeight="SemiBold" Foreground="#F0F6FC" />
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding NavigateCommand}" CommandParameter="GroqHunter" 
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" 
                                Background="Transparent" CornerRadius="6" Padding="12,10">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="⚡" FontSize="14" Foreground="#D29922" />
                                <TextBlock Text="AI Auto-Hunter" FontSize="13" FontWeight="SemiBold" Foreground="#F0F6FC" />
                            </StackPanel>
                        </Button>

                        <Separator Background="#30363D" Margin="0,8" />

                        <Button Command="{Binding NavigateCommand}" CommandParameter="Settings" 
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" 
                                Background="Transparent" CornerRadius="6" Padding="12,10">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="⚙" FontSize="14" Foreground="#8B949E" />
                                <TextBlock Text="Settings" FontSize="13" FontWeight="SemiBold" Foreground="#F0F6FC" />
                            </StackPanel>
                        </Button>

                    </StackPanel>

                    <!-- Sidebar Footer -->
                    <Border Grid.Row="1" Background="#0D1117" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="10">
                        <StackPanel Spacing="4">
                            <TextBlock Text="ISOLATED GIT BRANCH" FontSize="9" FontWeight="Bold" Foreground="#8B949E" />
                            <TextBlock Text="feature/avalonia-desktop" FontSize="10" FontFamily="Consolas, monospace" Foreground="#58A6FF" TextWrapping="Wrap" />
                            <TextBlock Text="Read-Only FastAPI Client" FontSize="9" Foreground="#3FB950" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                </Grid>
            </Border>

            <!-- Right Content Area -->
            <ContentControl Grid.Column="1" Content="{Binding CurrentViewModel}" />

        </Grid>

    </Grid>

</Window>
